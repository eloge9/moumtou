{% extends 'base.html.twig' %}
{% import 'components/_filtres_actifs.html.twig' as filtresActifs %}

{% block title %}Établissements — MOUMTOU{% endblock %}
{% block meta_description %}Découvrez les établissements partenaires de MOUMTOU et leurs talents, projets et soutenances vérifiés.{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('app_institution_index') }}">{% endblock %}

{% block header %}{% include 'components/_header.html.twig' with {active_nav: 'institutions'} %}{% endblock %}

{% block body %}
<div class="m-mise-en-page">

  <aside class="m-filtres">
    <form method="get" id="filtres-etablissements" data-filtres-auto>
      <input type="hidden" name="q" value="{{ criteria.query }}">
      <div class="d-flex align-items-center justify-content-between">
        <span class="m-surtitre" style="color:var(--m-encre)">Filtres</span>
        <a href="{{ path('app_institution_index') }}" style="color:var(--m-bleu);font-size:13px">Réinitialiser</a>
      </div>

      <div class="m-filtres__groupe">
        <p class="m-filtres__titre">Pays</p>
        <select class="m-select" name="country" aria-label="Pays">
          <option value="">Tous pays</option>
          {% for country in countries %}<option value="{{ country }}" {{ criteria.country == country ? 'selected' : '' }}>{{ country }}</option>{% endfor %}
        </select>
        <p class="m-filtres__titre mt-3">Ville</p>
        <input class="m-select" type="text" name="city" value="{{ criteria.city }}" placeholder="Ville" aria-label="Ville">
      </div>
    </form>
  </aside>

  <main class="m-resultats">
    <div class="d-flex align-items-end justify-content-between flex-wrap gap-3">
      <div>
        <h1 style="font-size:24px">Établissements</h1>
        <p class="m-meta mt-1 mb-0">{{ total }} établissement{{ total > 1 ? 's' : '' }}</p>
      </div>
      <form action="{{ path('app_institution_index') }}" method="get" style="min-width:280px">
        <label class="m-recherche flex-fill" style="width:100%">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8C97AB" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/></svg>
          <input type="search" name="q" value="{{ criteria.query }}" placeholder="Rechercher un établissement…" aria-label="Rechercher un établissement">
        </label>
      </form>
    </div>

    {% set hasActiveFilters = criteria.country or criteria.city %}
    {% if hasActiveFilters %}
      <div class="m-tags mt-3">
        {% if criteria.country %}{{ filtresActifs.tag('app_institution_index', 'country', null, criteria.country) }}{% endif %}
        {% if criteria.city %}{{ filtresActifs.tag('app_institution_index', 'city', null, criteria.city) }}{% endif %}
      </div>
    {% endif %}

    <div class="row g-3 mt-3">
      {% for institution in institutions %}
        {% set count = counts[institution.id]|default({projects: 0, defenses: 0}) %}
        <div class="col-xl-4 col-md-6">
          <article class="m-carte m-carte--plate p-4 h-100 text-center">
            <div class="m-avatar m-avatar--lg mx-auto" style="{% if institution.logo %}background-image:url('{{ asset(institution.logo) }}');background-size:cover{% endif %}"></div>
            <h2 class="mt-3 mb-1" style="font-size:17px">{{ institution.name }}</h2>
            <p class="m-meta mb-2">{{ institution.city }}{{ institution.city and institution.country ? ', ' : '' }}{{ institution.country }}</p>
            {% if institution.verified %}<span class="m-badge m-badge--verifie">✓ Établissement vérifié</span>{% endif %}
            <div class="d-flex justify-content-center gap-4 mt-3 pt-3" style="border-top:1px solid #EEF1F6">
              <div><span class="fw-bold d-block" style="font-size:18px">{{ count.projects }}</span><span class="m-meta">projet{{ count.projects > 1 ? 's' : '' }}</span></div>
              <div><span class="fw-bold d-block" style="font-size:18px">{{ count.defenses }}</span><span class="m-meta">soutenance{{ count.defenses > 1 ? 's' : '' }}</span></div>
            </div>
            <a class="m-btn m-btn--secondaire m-btn--bloc mt-3" href="{{ path('app_institution_show', {slug: institution.slug}) }}">Voir l'établissement</a>
          </article>
        </div>
      {% else %}
        <div class="col-12">
          <p class="m-meta">Aucun établissement ne correspond à cette recherche.</p>
        </div>
      {% endfor %}
    </div>

    {% if pageCount > 1 %}
      <nav class="m-pagination mt-4" aria-label="Pagination">
        {% for p in 1..pageCount %}
          <a class="{{ p == criteria.page ? 'is-active' : '' }}" href="{{ path('app_institution_index', app.request.query.all|merge({page: p})) }}">{{ p }}</a>
        {% endfor %}
      </nav>
    {% endif %}
  </main>
</div>
{% endblock %}
