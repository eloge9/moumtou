{% extends 'base.html.twig' %}

{% block title %}Préférences de notification — MOUMTOU{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}

{% block header %}{% include 'components/_header.html.twig' with {active_nav: 'notifications'} %}{% endblock %}

{% block body %}
<section class="p-4" style="max-width:640px;margin:0 auto">
  <div class="d-flex align-items-center justify-content-between">
    <h1 style="font-size:24px">Préférences de notification</h1>
    <a href="{{ path('app_notifications') }}" style="color:var(--m-bleu);font-size:13.5px">← Retour</a>
  </div>

  <form method="post" action="{{ path('app_notification_preferences') }}" class="mt-3">
    <div class="d-grid gap-3">
      {% for category in categories %}
        {% set pref = preferences[category.value] %}
        <div class="m-carte m-carte--plate p-3">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <p class="fw-bold mb-0" style="font-size:15px">{{ category.label }}</p>
            {% if category.mandatory %}<span class="m-meta">Toujours activées</span>{% endif %}
          </div>
          {% if not category.mandatory %}
            <div class="d-flex gap-4 mt-2">
              <label class="m-case"><input type="checkbox" name="in_app_{{ category.value }}" value="1" {{ pref.inApp ? 'checked' : '' }}><span>Notifications</span></label>
              <label class="m-case"><input type="checkbox" name="email_{{ category.value }}" value="1" {{ pref.email ? 'checked' : '' }}><span>E-mail</span></label>
            </div>
          {% else %}
            <p class="m-meta mt-2 mb-0">Ces alertes protègent votre compte et ne peuvent pas être désactivées.</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('notification-preferences') }}">
    <button class="m-btn m-btn--primaire mt-3" type="submit">Enregistrer</button>
  </form>
</section>
{% endblock %}
