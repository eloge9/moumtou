<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"></head>
<body style="margin:0;padding:0;background:#F7F8FB;font-family:Arial,sans-serif;color:#0B1B33;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F7F8FB;padding:32px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background:#ffffff;border:1px solid #E6E9F0;border-radius:14px;overflow:hidden;">
          <tr>
            <td style="background:#0A46E4;padding:20px 28px;">
              <span style="color:#ffffff;font-weight:800;font-size:18px;">MOUMTOU</span>
            </td>
          </tr>
          <tr>
            <td style="padding:28px;">
              <h1 style="font-size:20px;margin:0 0 12px;">Bonjour {{ juryMember.firstName }} {{ juryMember.lastName }},</h1>
              <p style="font-size:14.5px;line-height:1.6;color:#41506B;margin:0 0 12px;">
                Vous êtes invité(e) en tant que <strong>{{ juryMember.role.label }}</strong> à la soutenance de <strong>{{ project.owner.fullName }}</strong> :
              </p>
              <p style="font-size:14.5px;line-height:1.6;color:#0B1B33;margin:0 0 20px;">
                « {{ project.name }} »<br>
                {{ defense.date|date('d F Y') }} à {{ defense.time }} — {{ defense.place }}
              </p>
              <p style="text-align:center;margin:0 0 20px;">
                <a href="{{ signedUrl }}" style="display:inline-block;background:#0A46E4;color:#ffffff;text-decoration:none;font-weight:700;font-size:14.5px;padding:12px 24px;border-radius:9px;">Confirmer ma participation</a>
              </p>
              <p style="font-size:12.5px;color:#8C97AB;line-height:1.5;margin:0;">
                Ce lien reste valable 30 jours et ne nécessite pas de créer de compte.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
