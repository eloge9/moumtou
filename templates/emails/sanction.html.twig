<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"></head>
<body style="margin:0;padding:0;background:#F7F8FB;font-family:Arial,sans-serif;color:#0B1B33;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F7F8FB;padding:32px 0;">
    <tr><td align="center">
      <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background:#ffffff;border:1px solid #E6E9F0;border-radius:14px;overflow:hidden;">
        <tr><td style="background:#0A46E4;padding:20px 28px;"><span style="color:#ffffff;font-weight:800;font-size:18px;">MOUMTOU</span></td></tr>
        <tr><td style="padding:28px;">
          <h1 style="font-size:20px;margin:0 0 12px;">Bonjour {{ user.firstName }},</h1>
          <p style="font-size:14.5px;line-height:1.6;color:#41506B;margin:0 0 16px;">
            {% if sanction.type.value == 'avertissement' %}
              Un administrateur MOUMTOU vous adresse un avertissement concernant votre compte.
            {% elseif sanction.type.value == 'suspension' %}
              Votre compte MOUMTOU a été temporairement suspendu{% if sanction.endAt %} jusqu'au {{ sanction.endAt|date('d/m/Y') }}{% endif %}.
            {% else %}
              Votre compte MOUMTOU a été définitivement banni de la plateforme.
            {% endif %}
          </p>
          <p style="font-size:14px;line-height:1.6;color:#0B1B33;background:#F7F8FB;border-radius:9px;padding:14px;margin:0 0 16px;">
            <strong>Motif :</strong> {{ sanction.reason }}
          </p>
          <p style="font-size:12.5px;color:#8C97AB;line-height:1.5;margin:0;">Si vous estimez cette décision infondée, vous pouvez contacter l'équipe MOUMTOU en répondant à cet e-mail.</p>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
