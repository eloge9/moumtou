{% extends 'base.html.twig' %}
{% import 'components/_form_macros.html.twig' as forms %}

{% block title %}Ajouter une expérience — MOUMTOU{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}

{% block header %}{% include 'components/_header_minimal.html.twig' with {context_label: 'Ajouter une expérience'} %}{% endblock %}

{% block body %}
<section class="m-section d-flex justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <h1 class="mb-4" style="font-size:26px">Ajouter une expérience</h1>
    <div class="m-carte m-carte--plate p-4">
      {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        <div class="mb-3">
          {{ forms.label(form.title, 'Intitulé du poste', true) }}
          {{ form_widget(form.title, {attr: {class: 'm-input'}}) }}
          {{ form_errors(form.title) }}
        </div>
        <div class="mb-3">
          {{ forms.label(form.company, 'Entreprise / organisation', true) }}
          {{ form_widget(form.company, {attr: {class: 'm-input'}}) }}
          {{ form_errors(form.company) }}
        </div>
        <div class="mb-3">
          {{ form_label(form.city, null, {label_attr: {class: 'm-label'}}) }}
          {{ form_widget(form.city, {attr: {class: 'm-input'}}) }}
        </div>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            {{ forms.label(form.startDate, 'Début', true) }}
            {{ form_widget(form.startDate, {attr: {class: 'm-input'}}) }}
            {{ form_errors(form.startDate) }}
          </div>
          <div class="col-md-6">
            {{ form_label(form.endDate, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.endDate, {attr: {class: 'm-input'}}) }}
          </div>
        </div>
        <div class="mb-4">
          {{ form_label(form.description, null, {label_attr: {class: 'm-label'}}) }}
          {{ form_widget(form.description, {attr: {class: 'm-textarea'}}) }}
        </div>
        <div class="d-flex justify-content-end gap-2">
          <button class="m-btn m-btn--primaire" type="submit">Ajouter</button>
        </div>
      {{ form_end(form) }}
    </div>
  </div>
</section>
{% endblock %}
