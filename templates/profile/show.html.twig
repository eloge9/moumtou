{% extends 'base.html.twig' %}

{% block title %}{{ profileUser.fullName }}{{ profileUser.professionalTitle ? ' — ' ~ profileUser.professionalTitle : ' — Profil talent' }} — MOUMTOU{% endblock %}
{% block meta_description %}{{ (profileUser.bio ?: profileUser.fullName ~ ' présente ses projets et compétences sur MOUMTOU.')|striptags|slice(0, 160) }}{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('app_profile_show', {slug: profileUser.slug}) }}">{% endblock %}
{% block og_url %}<meta property="og:url" content="{{ publicUrl }}">{% endblock %}
{% block og_type %}profile{% endblock %}
{% block og_title %}{{ profileUser.fullName }} — MOUMTOU{% endblock %}
{% block og_description %}{{ block('meta_description') }}{% endblock %}
{% block og_image %}{% if profileUser.photo %}<meta property="og:image" content="{{ absolute_url(asset(profileUser.photo)) }}">{% endif %}{% endblock %}
{% block structured_data %}
<script type="application/ld+json">
{{ {
  '@context': 'https://schema.org',
  '@type': 'Person',
  'name': profileUser.fullName,
  'description': profileUser.bio,
  'jobTitle': profileUser.professionalTitle,
  'url': url('app_profile_show', {slug: profileUser.slug}),
  'address': (profileUser.city or profileUser.country) ? {'@type': 'PostalAddress', 'addressLocality': profileUser.city, 'addressCountry': profileUser.country} : null,
  'affiliation': profileUser.institution ? {'@type': 'CollegeOrUniversity', 'name': profileUser.institution.name} : null,
  'sameAs': [profileUser.linkedinUrl, profileUser.githubUrl, profileUser.websiteUrl, profileUser.portfolioUrl]|filter(v => v is not empty),
}|filter(v => v is not null)|json_encode|raw }}
</script>
{% endblock %}

{% block header %}{% include 'components/_header.html.twig' with {active_nav: 'talents'} %}{% endblock %}

{% block body %}

<section class="px-4 py-4" style="border-bottom:1px solid var(--m-bordure)">
  <div class="d-flex flex-wrap gap-4">
    <div class="m-avatar m-avatar--xl" style="{% if profileUser.photo %}background-image:url('{{ asset(profileUser.photo) }}');background-size:cover;background-position:center{% endif %}"></div>
    <div class="flex-fill" style="min-width:280px">
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <h1 style="font-size:32px">{{ profileUser.fullName }}</h1>
        {% if stats.verifiedCount > 0 %}<span class="m-badge m-badge--verifie">✓ {{ stats.verifiedCount }} projet{{ stats.verifiedCount > 1 ? 's' : '' }} vérifié{{ stats.verifiedCount > 1 ? 's' : '' }}</span>{% endif %}
        {% if stats.verifiedDefenseCount > 0 %}<span class="m-badge m-badge--verifie">✓ {{ stats.verifiedDefenseCount }} soutenance{{ stats.verifiedDefenseCount > 1 ? 's' : '' }} vérifiée{{ stats.verifiedDefenseCount > 1 ? 's' : '' }}</span>{% endif %}
      </div>
      {% if profileUser.professionalTitle %}<p class="fw-semibold mb-2" style="font-size:16px;color:var(--m-bleu)">{{ profileUser.professionalTitle }}</p>{% endif %}
      {% if profileUser.bio %}<p class="m-texte mb-3" style="max-width:560px">{{ profileUser.bio }}</p>{% endif %}
      <p class="m-meta mb-2">{% if profileUser.city or profileUser.country %}{{ profileUser.city }}{{ profileUser.city and profileUser.country ? ', ' : '' }}{{ profileUser.country }}{% endif %}</p>
      {% if profileUser.institution or profileUser.specialty %}
        <p class="m-meta mb-2 d-flex align-items-center gap-1">
          {% if profileUser.institution %}
            {% if profileUser.institution.logo %}<img src="{{ asset(profileUser.institution.logo) }}" alt="" width="16" height="16" style="border-radius:3px;object-fit:cover">{% else %}🎓{% endif %}
            {% if profileUser.institution.slug %}<a href="{{ path('app_institution_show', {slug: profileUser.institution.slug}) }}">{{ profileUser.institution.name }}</a>{% else %}{{ profileUser.institution.name }}{% endif %}
          {% endif %}
          {% if profileUser.specialty %}{{ profileUser.institution ? ' — ' : '' }}{{ profileUser.specialty.name }}{% endif %}
        </p>
      {% endif %}
      <div class="d-flex flex-wrap gap-2">
        {% if profileUser.whatsappEnabled and profileUser.whatsapp %}
          <a class="m-btn m-btn--primaire" href="https://wa.me/{{ profileUser.whatsapp }}" target="_blank" rel="noopener">Écrire sur WhatsApp</a>
        {% endif %}
        {% if profileUser.linkedinUrl %}<a class="m-btn m-btn--secondaire" href="{{ profileUser.linkedinUrl }}" target="_blank" rel="noopener">LinkedIn</a>{% endif %}
        {% if profileUser.githubUrl %}<a class="m-btn m-btn--secondaire" href="{{ profileUser.githubUrl }}" target="_blank" rel="noopener">GitHub</a>{% endif %}
        {% if profileUser.websiteUrl %}<a class="m-btn m-btn--secondaire" href="{{ profileUser.websiteUrl }}" target="_blank" rel="noopener">Site personnel</a>{% endif %}
        <button class="m-btn m-btn--secondaire" type="button" data-modale-ouvrir="modale-partage-profil">Partager</button>
        {% if isOwner %}<a class="m-btn m-btn--secondaire" href="{{ path('app_profile_edit') }}">Modifier mon profil</a>{% endif %}
        {% if recruiterContext %}
          {% if recruiterContext.isFavorite %}
            <form method="post" action="{{ path('app_recruiter_favorite_remove', {talentId: profileUser.id}) }}">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('favori-retirer-' ~ profileUser.id) }}">
              <button class="m-btn m-btn--secondaire" type="submit">★ Talent enregistré</button>
            </form>
          {% else %}
            <form method="post" action="{{ path('app_recruiter_favorite_add', {talentId: profileUser.id}) }}">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('favori-' ~ profileUser.id) }}">
              <button class="m-btn m-btn--secondaire" type="submit">☆ Ajouter aux talents intéressants</button>
            </form>
          {% endif %}
          {% if recruiterContext.hasPendingRequest %}
            <button class="m-btn m-btn--secondaire" type="button" disabled>Demande envoyée</button>
          {% else %}
            <button class="m-btn m-btn--primaire" type="button" data-modale-ouvrir="modale-contacter-talent">Contacter ce talent</button>
          {% endif %}
        {% endif %}
      </div>
    </div>
    <div class="d-grid gap-2" style="width:190px">
      <div class="m-stat"><div class="m-stat__valeur" style="font-size:24px">{{ stats.publishedCount }}</div><div class="m-stat__libelle">projets publiés</div></div>
      <div class="m-stat m-stat--bleu"><div class="m-stat__valeur" style="font-size:24px;color:var(--m-bleu)">{{ stats.verifiedCount }}</div><div class="m-stat__libelle">projets vérifiés</div></div>
      <div class="m-stat m-stat--bleu"><div class="m-stat__valeur" style="font-size:24px;color:var(--m-bleu)">{{ stats.verifiedDefenseCount }}</div><div class="m-stat__libelle">soutenances vérifiées</div></div>
      <div class="m-stat"><div class="m-stat__valeur" style="font-size:24px">{{ stats.averageRating|number_format(1, ',') }}</div><div class="m-stat__libelle">note moyenne</div></div>
      <div class="m-stat"><div class="m-stat__valeur" style="font-size:24px">{{ stats.totalViews }}</div><div class="m-stat__libelle">vues du profil</div></div>
    </div>
  </div>
</section>

<nav class="m-onglets" data-onglets aria-label="Sections du profil">
  <button class="m-onglet is-active" type="button" data-onglet="projets">Projets</button>
  <button class="m-onglet" type="button" data-onglet="competences">Compétences</button>
  <button class="m-onglet" type="button" data-onglet="soutenances">Soutenances</button>
  <button class="m-onglet" type="button" data-onglet="experiences">Expériences</button>
  {% if talentStats %}<button class="m-onglet" type="button" data-onglet="statistiques">Mes statistiques</button>{% endif %}
</nav>

<section class="px-4 py-4">
  <div class="row g-4">
    <div class="col-lg-8">

      <div class="m-onglet-panneau is-active" data-onglet-panneau="projets">
        <div class="d-flex align-items-center justify-content-between">
          <h2 style="font-size:19px">Projets publiés</h2>
          {% if isOwner %}<a class="m-btn m-btn--secondaire" href="{{ path('app_publish_start') }}">+ Nouveau projet</a>{% endif %}
        </div>
        <div class="d-grid gap-3 mt-3">
          {% for project in projects %}
            <article class="m-carte m-carte--plate p-3 d-flex gap-3 align-items-center flex-wrap">
              <div class="m-media" style="width:96px;height:66px;border-radius:var(--m-r-sm);padding:0;flex:none">
                {% if coverPhotos[project.id] is defined %}<img src="{{ asset(coverPhotos[project.id].thumbnailPath ?: coverPhotos[project.id].path) }}" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:var(--m-r-sm)" loading="lazy">{% endif %}
              </div>
              <div class="flex-fill" style="min-width:220px">
                <p class="mb-1 d-flex align-items-center gap-2">
                  <a class="fw-bold" style="font-size:15.5px" href="{{ path('app_project_show', {slug: project.slug}) }}">{{ project.name }}</a>
                  <span class="m-tag{{ project.status.value == 'verifie' ? ' m-tag--bleu' : '' }}">{{ project.status.value == 'verifie' ? 'Vérifié' : project.status.label }}</span>
                </p>
                <p class="m-meta mb-1">{{ project.type.shortLabel }} · {{ project.realizationDate ? project.realizationDate|date('Y') : project.createdAt|date('Y') }} · {{ project.technologies|map(t => t.name)|join(', ') }}</p>
                <p class="m-meta mb-0">★ {{ project.ratingAverage|number_format(1, ',') }} ({{ project.ratingsCount }}) · {{ project.viewsCount }} vues</p>
              </div>
            </article>
          {% else %}
            <p class="m-meta">Aucun projet pour l'instant.</p>
          {% endfor %}
        </div>
      </div>

      <div class="m-onglet-panneau" data-onglet-panneau="competences">
        <h2 style="font-size:19px">Compétences et technologies</h2>
        <div class="m-tags mt-3">
          {% for skill in profileUser.skills %}<span class="m-tag">{{ skill.name }}</span>{% else %}<span class="m-meta">Aucune compétence renseignée.</span>{% endfor %}
        </div>
        <div class="m-tags mt-3">
          {% for tech in profileUser.technologies %}<span class="m-tag m-tag--bleu">{{ tech.name }}</span>{% endfor %}
        </div>
      </div>

      <div class="m-onglet-panneau" data-onglet-panneau="soutenances">
        <h2 style="font-size:19px">Soutenances</h2>
        <div class="m-journal mt-3">
          {% for project in defenseProjects %}
            <div class="m-journal__ligne">
              <span class="m-journal__date">{{ project.defense.date|date('d M Y') }}</span>
              <span class="flex-fill"><a href="{{ path('app_project_show', {slug: project.slug}) }}">{{ project.name }}</a>{% if project.specialty %} — {{ project.specialty.name }}{% endif %}</span>
              <span class="m-journal__acteur{{ project.defense.status.value == 'verifiee' or project.status.value == 'verifie' ? ' m-journal__acteur--jury' : '' }}">{{ project.defense.status.label }}</span>
            </div>
          {% else %}
            <p class="m-meta">Aucune soutenance pour l'instant.</p>
          {% endfor %}
        </div>
      </div>

      <div class="m-onglet-panneau" data-onglet-panneau="experiences">
        <div class="d-flex align-items-center justify-content-between">
          <h2 style="font-size:19px">Expériences</h2>
          {% if isOwner %}<a class="m-btn m-btn--secondaire" href="{{ path('app_profile_add_experience') }}">+ Ajouter</a>{% endif %}
        </div>
        <div class="d-grid gap-3 mt-3">
          {% for experience in profileUser.experiences %}
            <div class="m-carte m-carte--plate p-3">
              <p class="fw-bold mb-1">{{ experience.title }} — {{ experience.company }}</p>
              <p class="m-meta mb-2">{{ experience.startDate|date('M Y') }} — {{ experience.endDate ? experience.endDate|date('M Y') : 'aujourd\'hui' }}{% if experience.city %} · {{ experience.city }}{% endif %}</p>
              {% if experience.description %}<p class="m-texte mb-0">{{ experience.description }}</p>{% endif %}
              {% if isOwner %}
                <form method="post" action="{{ path('app_profile_remove_experience', {id: experience.id}) }}" class="mt-2">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('supprimer-experience-' ~ experience.id) }}">
                  <button class="m-btn m-btn--lien p-0" style="color:#B3261E;font-size:13px" type="submit">Supprimer</button>
                </form>
              {% endif %}
            </div>
          {% else %}
            <p class="m-meta">Aucune expérience renseignée.</p>
          {% endfor %}
        </div>
      </div>

    </div>

    <div class="col-lg-4">
      <div class="d-grid gap-3">
        {% if profileUser.availability %}
          <div class="m-carte m-carte--plate p-3">
            <p class="m-surtitre mb-2">Disponibilité</p>
            <p class="fw-bold mb-0" style="font-size:15px;color:var(--m-bleu)">{{ profileUser.availability.label }}</p>
          </div>
        {% endif %}
        <div class="m-carte m-carte--plate p-3 text-center">
          <p class="m-surtitre mb-0">QR code du profil</p>
          <img src="{{ qrCodeDataUri }}" alt="QR code vers ce profil" width="100" height="100" class="mt-2">
          <p class="m-meta mt-2 mb-1">À imprimer sur un CV ou une carte de visite.</p>
          <a href="{{ qrCodeDataUri }}" download="moumtou-{{ profileUser.slug }}.svg">Télécharger le QR code</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% if talentStats %}
<section class="px-4 py-4 m-onglet-panneau" data-onglet-panneau="statistiques">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h2 style="font-size:19px" class="mb-0">Mes statistiques</h2>
    <form method="get" class="d-flex gap-2">
      <select class="m-select" name="periode" onchange="this.form.submit()" aria-label="Filtrer la période des statistiques">
        {% for value, label in statsPeriodChoices %}
          <option value="{{ value }}" {{ talentStats.period == value ? 'selected' }}>{{ label }}</option>
        {% endfor %}
      </select>
    </form>
  </div>
  <p class="m-meta mt-1">Uniquement les interactions mesurables sur MOUMTOU — jamais des chiffres inventés.</p>

  <div class="row g-2 mt-2">
    <div class="col-6 col-md-3"><div class="m-stat"><div class="m-stat__valeur" style="font-size:22px">{{ talentStats.aggregate.totalViews }}</div><div class="m-stat__libelle">vues totales</div></div></div>
    <div class="col-6 col-md-3"><div class="m-stat"><div class="m-stat__valeur" style="font-size:22px">{{ talentStats.aggregate.uniqueViews }}</div><div class="m-stat__libelle">vues uniques</div></div></div>
    <div class="col-6 col-md-3"><div class="m-stat"><div class="m-stat__valeur" style="font-size:22px">{{ talentStats.aggregate.shares }}</div><div class="m-stat__libelle">partages</div></div></div>
    <div class="col-6 col-md-3"><div class="m-stat"><div class="m-stat__valeur" style="font-size:22px">{{ talentStats.aggregate.qrViews }}</div><div class="m-stat__libelle">visites via QR code</div></div></div>
    <div class="col-6 col-md-3"><div class="m-stat"><div class="m-stat__valeur" style="font-size:22px">{{ talentStats.proofClicks.github|default(0) }}</div><div class="m-stat__libelle">clics GitHub</div></div></div>
    <div class="col-6 col-md-3"><div class="m-stat"><div class="m-stat__valeur" style="font-size:22px">{{ talentStats.proofClicks.demo|default(0) }}</div><div class="m-stat__libelle">clics démo</div></div></div>
    <div class="col-6 col-md-3"><div class="m-stat"><div class="m-stat__valeur" style="font-size:22px">{{ talentStats.proofClicks.site|default(0) }}</div><div class="m-stat__libelle">clics site web</div></div></div>
    <div class="col-6 col-md-3"><div class="m-stat"><div class="m-stat__valeur" style="font-size:22px">{{ talentStats.aggregate.qrDownloads }}</div><div class="m-stat__libelle">QR code téléchargé</div></div></div>
    {% if talentStats.favoritesReceivedCount is defined %}
      <div class="col-6 col-md-3"><div class="m-stat"><div class="m-stat__valeur" style="font-size:22px">{{ talentStats.favoritesReceivedCount }}</div><div class="m-stat__libelle">ajouts aux favoris (recruteurs)</div></div></div>
      <div class="col-6 col-md-3"><div class="m-stat"><div class="m-stat__valeur" style="font-size:22px">{{ talentStats.contactRequestsReceivedCount }}</div><div class="m-stat__libelle">demandes de contact reçues</div></div></div>
    {% endif %}
  </div>

  <div class="row g-3 mt-1">
    <div class="col-lg-8">
      <div class="m-carte m-carte--plate p-3">
        <p class="m-surtitre mb-3">Évolution des vues</p>
        {% set maxDaily = talentStats.dailyViews|reduce((max, v) => v > max ? v : max, 0) %}
        {% if maxDaily > 0 %}
          <div class="d-flex align-items-end gap-1" style="height:120px">
            {% for day, count in talentStats.dailyViews %}
              <div class="flex-fill" style="height:100%;display:flex;align-items:flex-end" title="{{ day }} : {{ count }} vue{{ count > 1 ? 's' : '' }}">
                <div style="width:100%;min-height:2px;height:{{ (count / maxDaily * 100)|round }}%;background:var(--m-bleu);border-radius:2px 2px 0 0"></div>
              </div>
            {% endfor %}
          </div>
          <div class="d-flex justify-content-between mt-2"><span class="m-meta">{{ talentStats.dailyViews|keys|first }}</span><span class="m-meta">{{ talentStats.dailyViews|keys|last }}</span></div>
        {% else %}
          <p class="m-meta mb-0">Pas encore de vues sur cette période.</p>
        {% endif %}
      </div>
    </div>
    <div class="col-lg-4">
      <div class="m-carte m-carte--plate p-3">
        <p class="m-surtitre mb-3">Mes projets les plus vus</p>
        {% for entry in talentStats.topProjects %}
          <div class="d-flex justify-content-between align-items-center mb-2" style="font-size:13.5px">
            <a href="{{ path('app_project_stats', {slug: entry.project.slug}) }}">{{ loop.index }}. {{ entry.project.name }}</a>
            <span class="m-meta">{{ entry.views }} vue{{ entry.views > 1 ? 's' : '' }}</span>
          </div>
        {% else %}
          <p class="m-meta mb-0">Pas encore de vues mesurées.</p>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{% block modals %}
<div class="m-modale" id="modale-partage-profil" data-modale role="dialog" aria-modal="true">
  <div class="m-modale__boite">
    <h2 class="m-modale__titre">Partager ce profil</h2>
    <label class="m-label mt-3" for="lien-partage-profil">Lien public</label>
    <input class="m-input" id="lien-partage-profil" type="text" value="{{ publicUrl }}" readonly>
    <div class="d-flex flex-wrap gap-2 mt-3">
      <a class="m-btn m-btn--secondaire" href="https://wa.me/?text={{ publicUrl|url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
      <a class="m-btn m-btn--secondaire" href="https://www.linkedin.com/sharing/share-offsite/?url={{ publicUrl|url_encode }}" target="_blank" rel="noopener">LinkedIn</a>
      <button class="m-btn m-btn--secondaire" type="button" onclick="navigator.clipboard.writeText('{{ publicUrl }}')">Copier le lien</button>
    </div>
    <div class="text-end mt-4"><button class="m-btn m-btn--primaire" type="button" data-modale-fermer>Fermer</button></div>
  </div>
</div>

{% if recruiterContext and not recruiterContext.hasPendingRequest %}
<div class="m-modale" id="modale-contacter-talent" data-modale role="dialog" aria-modal="true">
  <div class="m-modale__boite">
    <form method="post" action="{{ path('app_recruiter_contact_request_send', {talentId: profileUser.id}) }}">
      <h2 class="m-modale__titre">Contacter {{ profileUser.fullName }}</h2>
      <textarea class="m-textarea mt-3" name="message" maxlength="1000" required>Bonjour,

Je suis recruteur{% if app.user.recruiterProfile %} chez {{ app.user.recruiterProfile.organizationName }}{% endif %}.

Votre profil et vos projets nous intéressent particulièrement.

Nous souhaiterions échanger avec vous concernant une éventuelle opportunité.

Cordialement.</textarea>
      <p class="m-meta mt-2">1000 caractères maximum. Le talent choisit d'accepter ou de refuser votre demande.</p>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('contacter-' ~ profileUser.id) }}">
      <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="m-btn m-btn--secondaire" type="button" data-modale-fermer>Annuler</button>
        <button class="m-btn m-btn--primaire" type="submit">Envoyer la demande</button>
      </div>
    </form>
  </div>
</div>
{% endif %}
{% endblock %}
{% endblock %}
