{% extends 'base.html.twig' %}
{% import 'components/_form_macros.html.twig' as forms %}

{% block title %}Modifier mon profil — MOUMTOU{% endblock %}

{% block header %}{% include 'components/_header_minimal.html.twig' with {context_label: 'Modifier mon profil'} %}{% endblock %}

{% block body %}
<section class="m-section d-flex justify-content-center">
  <div class="col-12 col-md-10 col-lg-7">
    <h1 class="mb-4" style="font-size:26px">Modifier mon profil</h1>

    <div class="m-carte m-carte--plate p-4">
      {{ form_start(form, {attr: {novalidate: 'novalidate', enctype: 'multipart/form-data'}}) }}

        <div class="row g-3">
          <div class="col-md-6">
            {{ forms.label(form.firstName, 'Prénom', true) }}
            {{ form_widget(form.firstName, {attr: {class: 'm-input'}}) }}
            {{ form_errors(form.firstName) }}
          </div>
          <div class="col-md-6">
            {{ forms.label(form.lastName, 'Nom', true) }}
            {{ form_widget(form.lastName, {attr: {class: 'm-input'}}) }}
            {{ form_errors(form.lastName) }}
          </div>
          <div class="col-12">
            {{ form_label(form.professionalTitle, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.professionalTitle, {attr: {class: 'm-input'}}) }}
            {{ form_errors(form.professionalTitle) }}
          </div>
          <div class="col-md-6">
            {{ forms.label(form.phone, 'Téléphone', true) }}
            {{ form_widget(form.phone, {attr: {class: 'm-input'}}) }}
            {{ form_errors(form.phone) }}
          </div>
          <div class="col-md-6">
            {{ form_label(form.whatsapp, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.whatsapp, {attr: {class: 'm-input'}}) }}
          </div>
          <div class="col-12">
            {{ form_label(form.whatsappEnabled, null, {label_attr: {class: 'm-label'}}) }}
            <div class="d-flex gap-3">{{ form_widget(form.whatsappEnabled) }}</div>
          </div>
          <div class="col-md-6">
            {{ form_label(form.country, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.country, {attr: {class: 'm-input'}}) }}
          </div>
          <div class="col-md-6">
            {{ form_label(form.city, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.city, {attr: {class: 'm-input'}}) }}
          </div>
          <div class="col-12">
            {{ form_label(form.bio, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.bio, {attr: {class: 'm-textarea', maxlength: 2000}}) }}
            {{ form_errors(form.bio) }}
          </div>
          <div class="col-md-6">
            {{ form_label(form.linkedinUrl, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.linkedinUrl, {attr: {class: 'm-input'}}) }}
            {{ form_errors(form.linkedinUrl) }}
          </div>
          <div class="col-md-6">
            {{ form_label(form.githubUrl, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.githubUrl, {attr: {class: 'm-input'}}) }}
            {{ form_errors(form.githubUrl) }}
          </div>
          <div class="col-md-6">
            {{ form_label(form.websiteUrl, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.websiteUrl, {attr: {class: 'm-input'}}) }}
            {{ form_errors(form.websiteUrl) }}
          </div>
          <div class="col-md-6">
            {{ form_label(form.portfolioUrl, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.portfolioUrl, {attr: {class: 'm-input'}}) }}
            {{ form_errors(form.portfolioUrl) }}
          </div>
          <div class="col-md-6">
            {{ form_label(form.availability, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.availability, {attr: {class: 'm-select'}}) }}
          </div>
          <div class="col-md-6">
            {{ form_label(form.photo, null, {label_attr: {class: 'm-label'}}) }}
            {% if user.photo %}<img src="{{ asset(user.photo) }}" alt="" width="40" height="40" style="border-radius:50%;object-fit:cover;vertical-align:middle;margin-right:8px">{% endif %}
            {{ form_widget(form.photo, {attr: {class: 'm-input', style: 'display:inline-block;width:auto'}}) }}
            {{ form_errors(form.photo) }}
          </div>
          <div class="col-12 mt-2">
            <h2 style="font-size:17px" class="mb-0">Informations académiques</h2>
            <p class="m-meta mt-1 mb-0">Sélectionnez votre établissement dans le catalogue officiel. Ces informations sont distinctes de la classification de chaque projet publié.</p>
          </div>
          <div class="col-md-6">
            {{ form_label(form.institution, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.institution, {attr: {class: 'm-select'}}) }}
            <button class="m-btn m-btn--lien mt-1" type="button" data-modale-ouvrir="modale-demande-etablissement" style="padding:0;font-size:13px">Mon établissement n'est pas dans la liste</button>
          </div>
          <div class="col-md-6"></div>
          <div class="col-md-4">
            {{ form_label(form.domain, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.domain, {attr: {class: 'm-select'}}) }}
          </div>
          <div class="col-md-4">
            {{ form_label(form.mention, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.mention, {attr: {class: 'm-select'}}) }}
          </div>
          <div class="col-md-4">
            {{ form_label(form.specialty, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.specialty, {attr: {class: 'm-select'}}) }}
          </div>
          <div class="col-12">
            {{ form_label(form.skills, null, {label_attr: {class: 'm-label'}}) }}
            <div class="m-tags">{{ form_widget(form.skills) }}</div>
          </div>
          <div class="col-12" data-tags>
            {{ form_label(form.technologiesInput, null, {label_attr: {class: 'm-label'}}) }}
            {{ form_widget(form.technologiesInput, {attr: {class: 'd-none', 'data-tags-hidden': true}}) }}
            <input class="m-input" type="text" data-tags-input placeholder="Saisissez une technologie puis Entrée">
            <div class="m-tags mt-2" data-tags-liste>
              {% for tech in user.technologies %}<span class="m-chip is-active">{{ tech.name }} <span class="m-chip__x">&times;</span></span>{% endfor %}
            </div>
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3" style="border-top:1px solid var(--m-bordure)">
          <a class="m-btn m-btn--secondaire" href="{{ path('app_profile_show', {slug: user.slug}) }}">Annuler</a>
          <button class="m-btn m-btn--primaire" type="submit">Enregistrer</button>
        </div>
      {{ form_end(form) }}
    </div>

    {% if user.photo %}
      <div class="m-carte m-carte--plate p-4 mt-4">
        <h2 style="font-size:18px">Photo de profil</h2>
        <div class="d-flex align-items-center gap-3 mt-2">
          <img src="{{ asset(user.photo) }}" alt="" width="56" height="56" style="border-radius:50%;object-fit:cover">
          <form method="post" action="{{ path('app_profile_remove_photo') }}" onsubmit="return confirm('Supprimer votre photo de profil ?');">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('supprimer-photo-profil') }}">
            <button class="m-btn m-btn--secondaire" type="submit">Supprimer ma photo</button>
          </form>
        </div>
      </div>
    {% endif %}

    <div class="m-carte m-carte--plate p-4 mt-4">
      <h2 style="font-size:18px">Changer mon mot de passe</h2>
      <form method="post" action="{{ path('app_account_change_password') }}" class="mt-3">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="m-label" for="current_password">Mot de passe actuel</label>
            <input class="m-input" type="password" id="current_password" name="current_password" autocomplete="current-password" required>
          </div>
          <div class="col-md-4">
            <label class="m-label" for="new_password">Nouveau mot de passe</label>
            <input class="m-input" type="password" id="new_password" name="new_password" autocomplete="new-password" required minlength="8">
          </div>
          <div class="col-md-4">
            <label class="m-label" for="new_password_confirm">Confirmer</label>
            <input class="m-input" type="password" id="new_password_confirm" name="new_password_confirm" autocomplete="new-password" required minlength="8">
          </div>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('changer-mot-de-passe') }}">
        <div class="d-flex justify-content-end mt-3">
          <button class="m-btn m-btn--secondaire" type="submit">Mettre à jour le mot de passe</button>
        </div>
      </form>
    </div>

    <div class="m-carte m-carte--plate p-4 mt-4" style="border-color:#F5C6C2">
      <h2 style="font-size:18px;color:#B3261E">Supprimer mon compte</h2>
      <p class="m-texte mt-2">Cette action est définitive : vos informations personnelles seront effacées et vous ne pourrez plus vous connecter.</p>
      <form method="post" action="{{ path('app_account_delete') }}" class="mt-3" onsubmit="return confirm('Supprimer définitivement votre compte MOUMTOU ?');">
        <div class="col-md-6">
          <label class="m-label" for="delete_password">Confirmez avec votre mot de passe</label>
          <input class="m-input" type="password" id="delete_password" name="password" autocomplete="current-password" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('supprimer-compte') }}">
        <div class="d-flex justify-content-end mt-3">
          <button class="m-btn" style="background:#FDECEA;color:#B3261E;border:1px solid #F5C6C2" type="submit">Supprimer définitivement mon compte</button>
        </div>
      </form>
    </div>
  </div>
</section>

{% block modals %}
  {% include 'components/_institution_request_modal.html.twig' with {redirect_path: path('app_profile_edit')} %}
{% endblock %}
{% endblock %}
