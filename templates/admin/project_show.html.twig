{% extends 'admin/_layout.html.twig' %}
{% set adminNav = 'projects' %}

{% block title %}Administration — {{ project.name }} — MOUMTOU{% endblock %}
{% block admin_title %}Examiner un projet{% endblock %}

{% block admin_body %}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
  <div>
    <h1 style="font-size:22px" class="mb-1">{{ project.name }}</h1>
    <p class="m-meta mb-0">
      {{ project.type.label }} · Par <a href="{{ path('app_profile_show', {slug: project.owner.slug}) }}">{{ project.owner.fullName }}</a> ·
      {% if project.status.value == 'verifie' %}<span class="m-tag m-tag--bleu">Vérifié</span>
      {% elseif project.status.value == 'publie' %}<span class="m-tag">Publié — non vérifié</span>
      {% elseif project.status.value == 'rejete' %}<span class="m-tag" style="background:#FDECEA;color:#B3261E">Rejeté/masqué</span>
      {% else %}<span class="m-tag" style="background:#FFF4E5;color:#B36B00">{{ project.status.label }}</span>{% endif %}
    </p>
  </div>
  <a class="m-btn m-btn--secondaire" href="{{ path('app_project_show', {slug: project.slug}) }}" target="_blank" rel="noopener">Voir la page publique</a>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="m-carte m-carte--plate p-3">
      <p class="m-surtitre mb-2">Description</p>
      {% if project.shortDescription %}<p class="m-texte fw-semibold">{{ project.shortDescription }}</p>{% endif %}
      <p class="m-texte mb-0">{{ project.detailedDescription|default('Aucune description détaillée.')|nl2br }}</p>
    </div>

    <div class="m-carte m-carte--plate p-3 mt-3">
      <p class="m-surtitre mb-2">Classification</p>
      <div class="d-grid gap-1" style="font-size:13.5px">
        <div class="d-flex justify-content-between"><span class="m-meta">Domaine</span><span class="fw-semibold">{{ project.domain ? project.domain.name : '—' }}</span></div>
        <div class="d-flex justify-content-between"><span class="m-meta">Mention</span><span class="fw-semibold">{{ project.mention ? project.mention.name : '—' }}</span></div>
        <div class="d-flex justify-content-between"><span class="m-meta">Spécialité</span><span class="fw-semibold">{{ project.specialty ? project.specialty.name : '—' }}</span></div>
        <div class="d-flex justify-content-between"><span class="m-meta">Établissement</span><span class="fw-semibold">{{ project.institution ? project.institution.name : '—' }}</span></div>
        <div class="d-flex justify-content-between"><span class="m-meta">Date de réalisation</span><span class="fw-semibold">{{ project.realizationDate ? project.realizationDate|date('d/m/Y') : '—' }}</span></div>
      </div>
      {% if project.technologies|length %}
        <div class="m-tags mt-2">{% for tech in project.technologies %}<span class="m-tag">{{ tech.name }}</span>{% endfor %}</div>
      {% endif %}
    </div>

    <div class="m-carte m-carte--plate p-3 mt-3">
      <p class="m-surtitre mb-2">Preuves de réalisation ({{ project.proofs|length }})</p>
      {% for proof in project.proofs %}
        <a class="m-preuve d-block mb-2" href="{{ proof.url }}" target="_blank" rel="noopener">
          <span class="m-preuve__icone">{{ proof.type.icon }}</span>
          <span><span class="fw-bold d-block" style="font-size:14px">{{ proof.title ?: proof.type.label }}</span><span class="m-meta">{{ proof.url }}</span></span>
        </a>
      {% else %}
        <p class="m-meta mb-0">Aucune preuve fournie — le projet n'a pas encore de preuve à vérifier.</p>
      {% endfor %}
    </div>

    {% if project.documents|length %}
      <div class="m-carte m-carte--plate p-3 mt-3">
        <p class="m-surtitre mb-2">Documents ({{ project.documents|length }})</p>
        {% for document in project.documents %}
          <a class="m-preuve d-block mb-2" href="{{ asset(document.path) }}" target="_blank" rel="noopener">
            <span class="m-preuve__icone">📄</span>
            <span><span class="fw-bold d-block" style="font-size:14px">{{ document.title ?: document.type.label }}</span><span class="m-meta">{{ document.originalFilename }} · {{ (document.size / 1024 / 1024)|number_format(1) }} Mo</span></span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if project.photos|length %}
      <div class="m-carte m-carte--plate p-3 mt-3">
        <p class="m-surtitre mb-2">Photos ({{ project.photos|length }})</p>
        <div class="row g-2">
          {% for photo in project.photos %}
            <div class="col-3"><div class="m-media m-media--vignette" style="position:relative"><img src="{{ asset(photo.thumbnailPath ?: photo.path) }}" alt="" style="width:100%;height:100%;object-fit:cover">{% if loop.first %}<span class="m-tag m-tag--bleu" style="position:absolute;top:4px;left:4px">Principale</span>{% endif %}</div></div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if project.defense %}
      {% set defense = project.defense %}
      {% set result = defense.academicResult %}
      <div class="m-carte m-carte--plate p-3 mt-3">
        <p class="m-surtitre mb-2">Soutenance</p>
        <p class="m-texte mb-2">{{ defense.date|date('d/m/Y') }} — {{ defense.time }} — {{ defense.place }} ·
          {% if defense.status.value == 'verifiee' %}<span class="m-tag m-tag--bleu">✅ Vérifiée ({{ defense.validationCount }} membres)</span>
          {% elseif defense.status.value == 'realisee' %}<span class="m-tag" style="background:#FFF4E5;color:#B36B00">Réalisée — {{ defense.validationCount }}/2 validations</span>
          {% else %}<span class="m-tag">À venir</span>{% endif %}
        </p>
        <p class="m-surtitre mb-2 mt-3">Jury</p>
        <div class="d-grid gap-2">
          {% for membre in defense.juryMembers %}
            <div class="d-flex justify-content-between align-items-center" style="font-size:13.5px">
              <span>{{ membre.firstName }} {{ membre.lastName }} — {{ membre.role.label }}{% if membre.institutionLabel %} · {{ membre.institutionLabel }}{% endif %}</span>
              <span class="m-tag{{ membre.status.value == 'confirme' ? ' m-tag--bleu' : '' }}">{{ membre.status.label }}</span>
            </div>
          {% else %}
            <p class="m-meta mb-0">Aucun membre invité.</p>
          {% endfor %}
        </div>

        <p class="m-surtitre mb-2 mt-3">Résultat</p>
        {% if result %}
          <p class="m-texte mb-1">{{ result.status.label }}{% if result.decision.value != 'en_attente' %} — {{ result.decision.label }}{% endif %} {% if result.validated %}<span style="color:var(--m-bleu)">(validé)</span>{% else %}<span style="color:#B36B00">(non validé)</span>{% endif %}</p>
          {% if result.grade is not null %}<p class="m-texte mb-1">Note : {{ result.grade }}/{{ result.gradeScale|round }}</p>{% endif %}
          {% if result.appreciation %}<p class="m-texte mb-2" style="font-style:italic">« {{ result.appreciation }} »</p>{% endif %}
          {% if not result.validated %}
            <form method="post" action="{{ path('app_defense_result_validate', {id: defense.id}) }}">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('valider-resultat-' ~ defense.id) }}">
              <button class="m-btn m-btn--secondaire m-btn--sm" type="submit">Valider le résultat (admin)</button>
            </form>
          {% endif %}
        {% else %}
          <p class="m-meta mb-0">Aucun résultat saisi pour l'instant.</p>
        {% endif %}

        {% if defense.status.value == 'annoncee' %}
          <p class="m-surtitre mb-2 mt-3">Annuler / reporter (admin)</p>
          <form method="post" action="{{ path('app_defense_cancel', {id: project.id}) }}" class="mb-2" onsubmit="return confirm('Confirmer l\'annulation de cette soutenance ?');">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('soutenance-annuler-' ~ project.id) }}">
            <textarea class="m-textarea mb-2" name="reason" placeholder="Motif de l'annulation" required></textarea>
            <button class="m-btn m-btn--secondaire m-btn--sm" type="submit" style="color:#B3261E">Annuler la soutenance</button>
          </form>
          <form method="post" action="{{ path('app_defense_postpone', {id: project.id}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('soutenance-reporter-' ~ project.id) }}">
            <textarea class="m-textarea mb-2" name="reason" placeholder="Motif du report" required></textarea>
            <button class="m-btn m-btn--secondaire m-btn--sm" type="submit">Reporter la soutenance</button>
          </form>
        {% endif %}
      </div>
    {% endif %}

    {% if history|length %}
      <div class="m-carte m-carte--plate p-3 mt-3">
        <p class="m-surtitre mb-2">Historique de modération</p>
        <div class="m-journal">
          {% for h in history %}
            <div class="m-journal__ligne">
              <span class="m-journal__date">{{ h.createdAt|date('d/m/Y H:i') }}</span>
              <span class="flex-fill m-texte">{{ h.actionType.label }} par {{ h.admin.fullName }}{% if h.reason %} — {{ h.reason }}{% endif %}</span>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>

  <div class="col-lg-4">
    <div class="m-carte m-carte--plate m-carte--bleue p-3">
      <p class="m-surtitre m-surtitre--bleu mb-2">Décision</p>
      <form method="post" action="{{ path('admin_moderation_project_decide', {id: project.id}) }}">
        <div class="d-grid gap-2">
          <button class="m-btn m-btn--primaire m-btn--sm" type="submit" name="action" value="publier">Publier</button>
          <button class="m-btn m-btn--primaire m-btn--sm" type="submit" name="action" value="marquer_verifie">✅ Marquer comme vérifié</button>
          {% if project.status.value == 'verifie' %}
            <button class="m-btn m-btn--secondaire m-btn--sm" type="submit" name="action" value="retirer_verification">Retirer la vérification</button>
          {% endif %}
          <button class="m-btn m-btn--secondaire m-btn--sm" type="submit" name="action" value="demander_correction">Demander une correction</button>
          <button class="m-btn m-btn--secondaire m-btn--sm" type="submit" name="action" value="depublier">Dépublier</button>
          <button class="m-btn m-btn--secondaire m-btn--sm" type="submit" name="action" value="masquer" style="color:#B3261E">Masquer</button>
          <button class="m-btn m-btn--secondaire m-btn--sm" type="submit" name="action" value="supprimer" style="color:#B3261E" onclick="return confirm('Confirmer le retrait de ce projet ?');">Supprimer</button>
        </div>
        <label class="m-label mt-3" for="motif-projet">Motif (obligatoire pour « Demander une correction »)</label>
        <textarea class="m-textarea" id="motif-projet" name="reason" placeholder="Ex. : la preuve de réalisation est insuffisante. Ajoutez une démonstration ou un lien vers le projet."></textarea>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('moderation-projet-' ~ project.id) }}">
      </form>
    </div>

    {% if publicUrl %}
      <div class="m-carte m-carte--plate p-3 mt-3 text-center">
        <p class="m-surtitre mb-2">URL publique & QR code</p>
        <div class="d-grid gap-1 text-start mb-2" style="font-size:13px">
          <div class="d-flex justify-content-between"><span class="m-meta">Slug</span><span class="fw-semibold">{{ project.slug }}</span></div>
          <div class="d-flex justify-content-between"><span class="m-meta">Statut</span><span class="fw-semibold">{{ project.status.label }}</span></div>
        </div>
        <input class="m-input m-input--sm mb-2" type="text" value="{{ publicUrl }}" readonly aria-label="URL publique du projet {{ project.name }}">
        {% if project.status.value in ['publie', 'verifie'] %}
          <img src="{{ qrCodeDataUri }}" alt="QR Code permettant d'accéder au projet {{ project.name }} sur MOUMTOU" width="90" height="90">
        {% else %}
          <p class="m-meta mb-0">Le QR code redirige vers une page qui affichera « projet indisponible » tant que ce projet n'est pas publié — il fonctionnera normalement dès la publication.</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
