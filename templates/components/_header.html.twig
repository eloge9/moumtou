{#
  Variables attendues : active_nav ("explorer", "soutenances", "talents", "profil"…)
  Note : les liens vers des fonctionnalités pas encore développées pointent vers "#",
  exactement comme dans la maquette de référence (code/README.md, section "À remplacer
  avant mise en production"). Ils sont remplacés par path() au fur et à mesure que
  chaque écran est implémenté.

  La navigation s'adapte au profil connecté (Talent/Enseignant/Recruteur/Admin) sans
  jamais remplacer la vérification serveur : cacher un lien n'est qu'un confort visuel,
  chaque route reste protégée indépendamment (security.yaml + #[IsGranted] + Voters).
#}
<header class="m-header">
  <a class="m-brand" href="{{ path('app_home') }}"><span class="m-brand__mark">M</span>MOUMTOU</a>
  <button class="m-header__toggle" type="button" data-nav-toggle aria-expanded="false" aria-label="Ouvrir le menu">☰</button>
  <nav class="m-nav" data-nav>
    <a class="m-nav__link{{ active_nav|default('') == 'explorer' ? ' is-active' : '' }}" href="{{ path('app_explorer') }}">Explorer</a>
    <a class="m-nav__link{{ active_nav|default('') == 'soutenances' ? ' is-active' : '' }}" href="{{ path('app_explorer', {'types[]': 'soutenance'}) }}">Soutenances</a>
    <a class="m-nav__link{{ active_nav|default('') == 'talents' ? ' is-active' : '' }}" href="{{ is_granted('ROLE_RECRUITER') ? path('app_recruiter_search') : path('app_search', {type: 'talents'}) }}">Talents</a>
  </nav>
  <div class="ms-auto d-flex align-items-center gap-3">
    <form action="{{ path('app_search') }}" method="get" data-recherche-globale style="position:relative">
      <label class="m-recherche">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8C97AB" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/></svg>
        <input type="search" name="q" placeholder="Rechercher un talent, une techno…" aria-label="Rechercher" autocomplete="off" data-recherche-champ>
      </label>
      <div class="m-suggestions" data-recherche-suggestions hidden></div>
    </form>
    {% if app.user %}
      <div class="m-menu" data-menu>
        <button class="m-btn m-btn--lien" type="button" data-menu-bouton>{{ app.user.firstName }} ▾</button>
        <div class="m-menu__liste">
          {# Un compte peut cumuler plusieurs rôles (multi-rôle) : chaque
             section reste indépendante, pas de "elseif" qui masquerait les
             autres espaces auxquels ce compte a réellement accès. #}
          {% if is_granted('ROLE_TALENT') %}
            <a class="m-menu__item" href="{{ path('app_profile_show', {slug: app.user.slug}) }}">Mon profil</a>
            <a class="m-menu__item" href="{{ path('app_publish_start') }}">Publier un projet</a>
            <a class="m-menu__item" href="{{ path('app_defense_manage') }}">Ma soutenance</a>
            {% set pendingContactRequestsCount = pending_contact_requests_count() %}
            <a class="m-menu__item" href="{{ path('app_talent_contact_requests') }}">Demandes de recrutement{% if pendingContactRequestsCount > 0 %} <span class="m-admin__compteur m-admin__compteur--alerte">{{ pendingContactRequestsCount }}</span>{% endif %}</a>
          {% endif %}
          {% if is_granted('ROLE_TEACHER') %}
            <a class="m-menu__item" href="{{ path('app_teacher_dashboard') }}">Mon espace enseignant</a>
          {% endif %}
          {% if is_granted('ROLE_RECRUITER') %}
            <a class="m-menu__item" href="{{ path('app_recruiter_dashboard') }}">Mon espace recruteur</a>
          {% else %}
            <a class="m-menu__item" href="{{ path('app_recruiter_profile_edit') }}">Devenir recruteur</a>
          {% endif %}
          {% if is_granted('ROLE_ADMIN') %}<a class="m-menu__item" href="{{ path('admin_dashboard') }}">Administration</a>{% endif %}
          <a class="m-menu__item" href="{{ path('app_logout') }}">Déconnexion</a>
        </div>
      </div>
    {% else %}
      <a class="m-btn m-btn--lien" href="{{ path('app_login') }}">Se connecter</a>
    {% endif %}
    {% if not app.user or is_granted('ROLE_TALENT') %}
      <a class="m-btn m-btn--primaire" href="{{ path('app_publish_start') }}">Publier mon projet</a>
    {% elseif is_granted('ROLE_RECRUITER') %}
      <a class="m-btn m-btn--primaire" href="{{ path('app_recruiter_search') }}">Rechercher un talent</a>
    {% endif %}
  </div>
</header>
