<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}MOUMTOU{% endblock %}</title>
<meta name="description" content="{% block meta_description %}MOUMTOU — la plateforme où les talents démontrent leurs réalisations : projets, soutenances et compétences, découverts par des recruteurs.{% endblock %}">
<meta name="robots" content="{% block meta_robots %}index, follow{% endblock %}">
{% block canonical %}{% endblock %}
<meta property="og:site_name" content="MOUMTOU">
<meta property="og:type" content="{% block og_type %}website{% endblock %}">
<meta property="og:title" content="{% block og_title %}MOUMTOU{% endblock %}">
<meta property="og:description" content="{% block og_description %}MOUMTOU — la plateforme où les talents démontrent leurs réalisations.{% endblock %}">
{% block og_image %}{% endblock %}
<meta name="twitter:card" content="summary_large_image">
{% block structured_data %}{% endblock %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="{{ asset('css/moumtou.css') }}" rel="stylesheet">
{% block stylesheets %}{% endblock %}
</head>
<body class="{% block body_class %}m-page{% endblock %}">

{% block header %}
    {% include 'components/_header.html.twig' %}
{% endblock %}

{% for message in app.flashes('succes') %}
  <p class="m-avis m-0 rounded-0 text-center" style="border-width:0 0 1px;">{{ message }}</p>
{% endfor %}
{% for message in app.flashes('erreur') %}
  <p class="m-avis m-0 rounded-0 text-center" style="color:#B3261E;background:#FDECEA;border-width:0 0 1px;border-color:#F5C6C2">{{ message }}</p>
{% endfor %}

{% block body %}{% endblock %}

{% block modals %}{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('js/moumtou.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
