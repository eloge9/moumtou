{% extends 'base.html.twig' %}
{% import 'components/_form_macros.html.twig' as forms %}

{% block title %}Ma soutenance — MOUMTOU{% endblock %}

{% block header %}{% include 'components/_header.html.twig' with {active_nav: 'soutenances'} %}{% endblock %}

{% block body %}

{% if not project %}
  <section class="m-section d-flex justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 text-center">
      <div class="m-carte m-carte--plate p-4">
        <h1 style="font-size:22px">Aucune soutenance en cours</h1>
        <p class="m-texte mt-2">Publiez d'abord un projet de type « Soutenance » pour pouvoir l'annoncer ici.</p>
        <a class="m-btn m-btn--primaire mt-3" href="{{ path('app_publish_start') }}">Publier mon projet</a>
      </div>
    </div>
  </section>
{% else %}

  <div class="row g-0">
    <main class="col-lg-8 p-4" style="border-right:1px solid var(--m-bordure)">

      {% if not defense %}
        <div class="m-carte m-carte--plate p-4">
          <p class="m-surtitre m-surtitre--bleu mb-2">Annoncer ma soutenance</p>
          <h1 style="font-size:22px">{{ project.name }}</h1>
          {{ form_start(announceForm, {action: path('app_defense_announce', {id: project.id}), attr: {novalidate: 'novalidate'}}) }}
            <div class="row g-3 mt-2">
              <div class="col-md-4">
                {{ forms.label(announceForm.date, 'Date', true) }}
                {{ form_widget(announceForm.date, {attr: {class: 'm-input'}}) }}
              </div>
              <div class="col-md-4">
                {{ forms.label(announceForm.time, 'Heure', true) }}
                {{ form_widget(announceForm.time, {attr: {class: 'm-input'}}) }}
              </div>
              <div class="col-md-4">
                {{ forms.label(announceForm.place, 'Lieu', true) }}
                {{ form_widget(announceForm.place, {attr: {class: 'm-input'}}) }}
              </div>
            </div>
            <button class="m-btn m-btn--primaire mt-3" type="submit">Publier l'annonce</button>
          {{ form_end(announceForm) }}
        </div>
      {% else %}
        <div class="m-carte m-carte--bleue p-4">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span class="m-badge" style="background:var(--m-bleu);border-color:var(--m-bleu);color:#fff">{{ defense.status.label }}</span>
          </div>
          <h1 class="mt-3" style="font-size:27px">{{ project.name }}</h1>
          <div class="d-flex flex-wrap gap-5 mt-3">
            <div><p class="m-surtitre mb-1">Date</p><p class="fw-bold mb-0">{{ defense.date|date('d M Y') }} · {{ defense.time }}</p></div>
            <div><p class="m-surtitre mb-1">Lieu</p><p class="fw-bold mb-0">{{ defense.place }}</p></div>
            {% if project.specialty %}<div><p class="m-surtitre mb-1">Spécialité</p><p class="fw-bold mb-0">{{ project.specialty.name }}</p></div>{% endif %}
          </div>
        </div>

        {% if defense.status.value != 'verifiee' %}
        <section class="mt-5">
          <div class="d-flex align-items-baseline gap-3 flex-wrap">
            <h2 style="font-size:19px">Après la soutenance</h2>
            <span class="m-meta">Complétez le dossier pour obtenir la vérification.</span>
          </div>
          <form method="post" action="{{ path('app_defense_complete', {id: project.id}) }}" enctype="multipart/form-data">
            <div class="row g-3 mt-2">
              <div class="col-md-6">
                <label class="m-label" for="photos-soutenance">Photos de la soutenance</label>
                <label class="m-depot" for="photos-soutenance"><span style="font-size:18px;color:var(--m-bleu)">⇪</span>Glisser des images (JPG, PNG, WebP)</label>
                <input class="d-none" id="photos-soutenance" type="file" name="photos[]" accept="image/*" multiple>
              </div>
              <div class="col-md-6">
                <label class="m-label" for="video-soutenance">Vidéo de la présentation</label>
                <input class="m-input" id="video-soutenance" name="video_url" type="url" placeholder="https://youtube.com/watch?v=…">
                <label class="m-label mt-3" for="resultat">Résultat obtenu (optionnel)</label>
                <select class="m-select" id="resultat" name="result">
                  <option value="">Mention</option><option>Passable</option><option>Assez bien</option><option>Bien</option><option>Très bien</option>
                </select>
              </div>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('soutenance-completer-' ~ project.id) }}">
            <button class="m-btn m-btn--secondaire mt-3" type="submit">Enregistrer</button>
          </form>

          {% if defense.status.value == 'annoncee' %}
            <form method="post" action="{{ path('app_defense_mark_realized', {id: project.id}) }}" class="mt-3">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('soutenance-realisee-' ~ project.id) }}">
              <button class="m-btn m-btn--sombre" type="submit">Marquer la soutenance comme réalisée</button>
              <span class="m-meta ms-2">Le statut passe à « réalisée », puis « vérifiée » après confirmation du jury.</span>
            </form>
          {% endif %}
        </section>
        {% endif %}
      {% endif %}
    </main>

    <aside class="col-lg-4 p-4" style="background:var(--m-fond)">
      {% if defense %}
        <div class="d-grid gap-3">
          <div class="m-carte m-carte--plate p-3">
            <div class="d-flex align-items-center justify-content-between">
              <span class="m-surtitre">Membres du jury</span>
            </div>
            <div class="mt-2">
              {% for membre in defense.juryMembers %}
                <div class="d-flex align-items-center gap-2 py-2" style="border-bottom:1px solid #EEF1F6">
                  <span class="m-avatar" style="width:32px;height:32px"></span>
                  <span class="flex-fill"><span class="fw-bold d-block" style="font-size:14px">{{ membre.firstName }} {{ membre.lastName }}</span><span class="m-meta">{{ membre.role.label }}{% if membre.institutionLabel %} · {{ membre.institutionLabel }}{% endif %}</span></span>
                  <span class="m-tag{{ membre.status.value == 'confirme' ? ' m-tag--bleu' : '' }}">{{ membre.status.label }}</span>
                </div>
              {% else %}
                <p class="m-meta">Aucun membre invité pour l'instant.</p>
              {% endfor %}
            </div>

            {% if inviteForm %}
              {{ form_start(inviteForm, {action: path('app_defense_invite_jury', {id: project.id}), attr: {class: 'mt-3'}}) }}
                <label class="m-label mt-2">{{ form_label(inviteForm.firstName, 'Prénom') }}</label>
                {{ form_widget(inviteForm.firstName, {attr: {class: 'm-input'}}) }}
                {{ form_widget(inviteForm.lastName, {attr: {class: 'm-input mt-2', placeholder: 'Nom'}}) }}
                {{ form_widget(inviteForm.role, {attr: {class: 'm-select mt-2'}}) }}
                {{ form_widget(inviteForm.institution, {attr: {class: 'm-select mt-2'}}) }}
                {{ form_widget(inviteForm.institutionName, {attr: {class: 'm-input mt-2', placeholder: 'Ou établissement absent du catalogue'}}) }}
                <button class="m-btn m-btn--lien mt-1" type="button" data-modale-ouvrir="modale-demande-etablissement" style="padding:0;font-size:13px">Cet établissement n'est pas dans la liste</button>
                {{ form_widget(inviteForm.email, {attr: {class: 'm-input mt-2', placeholder: 'E-mail'}}) }}
                <button class="m-btn m-btn--secondaire m-btn--bloc mt-2" type="submit">+ Inviter</button>
              {{ form_end(inviteForm) }}
            {% endif %}
          </div>

          <div class="m-carte m-carte--plate m-encre-fond p-3">
            <p class="m-surtitre mb-2" style="color:#9AA8C0">Statut de vérification</p>
            <p class="fw-bold mb-1 d-flex align-items-center gap-2" style="font-size:18px"><span style="width:9px;height:9px;border-radius:50%;background:#5B8CFF"></span>{{ defense.status.label }}</p>
            <p class="mb-0" style="color:#9AA8C0;font-size:13.5px">Confirmée par {{ defense.confirmedCount }} membre{{ defense.confirmedCount > 1 ? 's' : '' }} du jury. Le badge est visible sur la page publique du projet.</p>
          </div>
        </div>
      {% endif %}
    </aside>
  </div>
{% endif %}
{% endblock %}

{% block modals %}
  {% include 'components/_institution_request_modal.html.twig' with {redirect_path: path('app_defense_manage')} %}
{% endblock %}
