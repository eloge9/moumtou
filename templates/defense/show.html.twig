{% extends 'base.html.twig' %}

{% block title %}Soutenance — {{ project.name }} — MOUMTOU{% endblock %}
{% block meta_description %}Soutenance de {{ project.owner.fullName }} : {{ project.name }}, le {{ defense.date|date('d F Y') }}{% if project.institution %} à {{ project.institution.name }}{% endif %}.{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ publicUrl }}">{% endblock %}
{% block og_type %}article{% endblock %}
{% block og_title %}Soutenance — {{ project.name }} — MOUMTOU{% endblock %}
{% block og_description %}{{ block('meta_description') }}{% endblock %}
{% block og_image %}{% if project.photos|length %}<meta property="og:image" content="{{ absolute_url(asset(project.photos.first.path)) }}">{% endif %}{% endblock %}
{% block structured_data %}
<script type="application/ld+json">
{{ {
  '@context': 'https://schema.org',
  '@type': 'EducationEvent',
  'name': 'Soutenance — ' ~ project.name,
  'startDate': defense.date|date('Y-m-d') ~ 'T' ~ defense.time ~ ':00',
  'location': {'@type': 'Place', 'name': defense.place},
  'organizer': project.institution ? {'@type': 'CollegeOrUniversity', 'name': project.institution.name} : null,
  'performer': {'@type': 'Person', 'name': project.owner.fullName},
  'url': publicUrl,
  'eventStatus': defense.status.value == 'annoncee' ? 'https://schema.org/EventScheduled' : 'https://schema.org/EventScheduled',
}|filter(v => v is not null)|json_encode|raw }}
</script>
{% endblock %}

{% block header %}{% include 'components/_header.html.twig' with {active_nav: 'soutenances'} %}{% endblock %}

{% block body %}
<p class="m-fil m-0 px-4 py-3" style="background:var(--m-fond);border-bottom:1px solid var(--m-bordure)">
  <a href="{{ path('app_explorer') }}">Explorer</a> / <strong>Soutenances</strong>
</p>

<div class="m-detail">
  <main class="m-detail__principal">
    <div class="d-flex flex-wrap gap-2">
      {% if defense.status.value == 'annoncee' %}
        <span class="m-badge" style="background:var(--m-bleu);border-color:var(--m-bleu);color:#fff">📅 SOUTENANCE À VENIR</span>
      {% elseif defense.status.value == 'reportee' %}
        <span class="m-badge" style="color:#B36B00;background:#FFF4E5">🔁 SOUTENANCE REPORTÉE</span>
      {% elseif defense.status.value == 'annulee' %}
        <span class="m-badge" style="color:#B3261E;background:#FDECEA">❌ SOUTENANCE ANNULÉE</span>
      {% elseif defense.status.value == 'realisee' %}
        <span class="m-badge">🌐 Soutenance réalisée</span>
        <span class="m-badge" style="color:#B36B00;background:#FFF4E5">⚠️ Pas encore vérifiée</span>
      {% else %}
        <span class="m-badge m-badge--verifie">✅ SOUTENANCE VÉRIFIÉE</span>
      {% endif %}
    </div>

    <h1 class="mt-3" style="font-size:34px;line-height:1.1;letter-spacing:-.032em;max-width:640px">{{ project.name }}</h1>
    {% if project.theme %}<p class="m-texte mt-2" style="font-size:16px">{{ project.theme }}</p>{% endif %}

    <div class="d-flex align-items-center gap-3 mt-4 py-3" style="border-top:1px solid #EEF1F6;border-bottom:1px solid #EEF1F6">
      <span class="m-avatar" style="width:44px;height:44px;{% if project.owner.photo %}background-image:url('{{ asset(project.owner.photo) }}');background-size:cover{% endif %}"></span>
      <div>
        <p class="fw-bold mb-0" style="font-size:15.5px"><a href="{{ path('app_profile_show', {slug: project.owner.slug}) }}">{{ project.owner.fullName }}</a></p>
        <p class="m-meta mb-0">{{ project.institution ? project.institution.name : '' }}</p>
      </div>
    </div>

    {% if defense.status.value == 'reportee' %}
      <p class="m-avis mt-3" style="color:#B36B00;background:#FFF4E5;border-color:#F3D9A8">Cette soutenance, initialement prévue le {{ defense.previousDate|date('d F Y') }}, a été reportée. La nouvelle date sera annoncée prochainement.</p>
    {% elseif defense.status.value == 'annulee' %}
      <p class="m-avis mt-3" style="color:#B3261E;background:#FDECEA;border-color:#F5C6C2">Cette soutenance a été annulée.</p>
    {% else %}
    <div class="row g-3 mt-3">
      <div class="col-md-4"><p class="m-surtitre mb-1">Date</p><p class="fw-bold mb-0">{{ defense.date|date('d F Y') }}</p></div>
      <div class="col-md-4"><p class="m-surtitre mb-1">Heure</p><p class="fw-bold mb-0">{{ defense.time }}</p></div>
      <div class="col-md-4"><p class="m-surtitre mb-1">Lieu</p><p class="fw-bold mb-0">{{ defense.place }}</p></div>
    </div>
    {% endif %}

    {% if project.domain or project.mention or project.specialty %}
      <div class="row g-2 mt-2" style="font-size:13.5px">
        {% if project.domain %}<div class="col-auto"><span class="m-tag">{{ project.domain.name }}</span></div>{% endif %}
        {% if project.mention %}<div class="col-auto"><span class="m-tag">{{ project.mention.name }}</span></div>{% endif %}
        {% if project.specialty %}<div class="col-auto"><span class="m-tag m-tag--bleu">{{ project.specialty.name }}</span></div>{% endif %}
      </div>
    {% endif %}

    {% if project.detailedDescription %}
      <h2 class="mt-5" style="font-size:20px">Description</h2>
      <p class="m-texte mt-2" style="font-size:15.5px;line-height:1.65;max-width:680px">{{ project.detailedDescription|nl2br }}</p>
    {% endif %}

    {% if project.technologies|length %}
      <h2 class="mt-4" style="font-size:20px">Technologies</h2>
      <div class="m-tags mt-2">{% for tech in project.technologies %}<span class="m-tag">{{ tech.name }}</span>{% endfor %}</div>
    {% endif %}

    {% if youtubeEmbedUrl %}
      <div class="mt-4" style="position:relative;padding-top:56.25%;border-radius:var(--m-r);overflow:hidden">
        <iframe src="{{ youtubeEmbedUrl }}" title="Vidéo de la soutenance" frameborder="0" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%"></iframe>
      </div>
    {% endif %}

    {% if project.photos|length %}
      <h2 class="mt-4" style="font-size:20px">Photos</h2>
      <div class="row g-2 mt-2">
        {% for photo in project.photos %}
          <div class="col-3"><div class="m-media m-media--vignette"><img src="{{ asset(photo.thumbnailPath ?: photo.path) }}" alt="" style="width:100%;height:100%;object-fit:cover" loading="lazy"></div></div>
        {% endfor %}
      </div>
    {% endif %}

    {% if project.proofs|length %}
      <h2 class="mt-4" style="font-size:20px">Preuves</h2>
      <div class="row g-3 mt-2">
        {% for proof in project.proofs %}
          <div class="col-md-6">
            <a class="m-preuve" href="{{ proof.url }}" target="_blank" rel="noopener">
              <span><span class="fw-bold d-block" style="font-size:14.5px">{{ proof.type.label }}</span><span class="m-meta">{{ proof.url }}</span></span>
            </a>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if result and result.resultVisible %}
      <section class="mt-5 pt-4" style="border-top:1px solid var(--m-bordure)">
        <h2 style="font-size:20px">Résultat</h2>
        <p class="m-texte mt-2">Résultat : <strong>{{ result.status.label }}</strong>{% if result.decision.value != 'en_attente' %} — {{ result.decision.label }}{% endif %}</p>
        {% if result.gradeVisible and result.grade is not null %}<p class="m-texte">Note : <strong>{{ result.grade }}/{{ result.gradeScale|round }}</strong></p>{% endif %}
        {% if result.appreciationVisible and result.appreciation %}<p class="m-texte mt-2" style="font-style:italic">« {{ result.appreciation }} »</p>{% endif %}
        {% if not result.validated %}<p class="m-meta mt-2">Résultat en attente de validation officielle.</p>{% endif %}
      </section>
    {% endif %}
  </main>

  <aside class="m-detail__cote">
    <div class="m-carte m-carte--plate p-3">
      <p class="m-surtitre mb-2">Jury</p>
      <div class="d-grid gap-3">
        {% for membre in defense.juryMembers %}
          <div class="d-flex align-items-center gap-2 {{ membre.status.value != 'confirme' ? 'opacity-75' : '' }}">
            <span class="m-avatar" style="width:30px;height:30px"></span>
            <span class="flex-fill"><span class="fw-bold d-block" style="font-size:14px">{{ membre.firstName }} {{ membre.lastName }}</span><span class="m-meta">{{ membre.role.label }}{% if membre.institutionLabel %} · {{ membre.institutionLabel }}{% endif %}</span></span>
          </div>
        {% else %}
          <p class="m-meta mb-0">Jury non encore constitué.</p>
        {% endfor %}
      </div>
    </div>

    {% if defense.status.value == 'verifiee' %}
      <div class="m-carte m-carte--plate p-3" style="border-color:var(--m-bleu-bordure)">
        <p class="m-statut mb-0">✅ Vérifiée par {{ defense.validationCount }} membre{{ defense.validationCount > 1 ? 's' : '' }} du jury</p>
      </div>
    {% endif %}

    {% if defense.status.value == 'annoncee' %}
      <div class="m-carte m-carte--plate p-3 text-center">
        <p class="m-surtitre mb-2">Ne manquez pas cette soutenance</p>
        <a class="m-btn m-btn--primaire m-btn--bloc" href="{{ calendarUrl }}">📅 Ajouter à mon calendrier</a>
      </div>
    {% endif %}

    <div class="m-carte m-carte--plate p-3 text-center">
      <p class="m-surtitre mb-2">Partager</p>
      <button class="m-btn m-btn--secondaire m-btn--bloc" type="button" data-modale-ouvrir="modale-partage-soutenance">Partager cette soutenance</button>
      <a class="m-btn m-btn--secondaire m-btn--bloc mt-2" href="{{ path('app_project_show', {slug: project.slug}) }}">Voir la fiche complète du projet</a>
    </div>
  </aside>
</div>

{% block modals %}
<div class="m-modale" id="modale-partage-soutenance" data-modale role="dialog" aria-modal="true">
  <div class="m-modale__boite">
    <h2 class="m-modale__titre">Partager cette soutenance</h2>
    <label class="m-label mt-3" for="lien-partage-soutenance">Lien public</label>
    <input class="m-input" id="lien-partage-soutenance" type="text" value="{{ publicUrl }}" readonly>
    <div class="d-flex flex-wrap gap-2 mt-3">
      <a class="m-btn m-btn--secondaire" href="https://wa.me/?text={{ publicUrl|url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
      <a class="m-btn m-btn--secondaire" href="https://www.linkedin.com/sharing/share-offsite/?url={{ publicUrl|url_encode }}" target="_blank" rel="noopener">LinkedIn</a>
      <button class="m-btn m-btn--secondaire" type="button" onclick="navigator.clipboard.writeText('{{ publicUrl }}')">Copier le lien</button>
    </div>
    <div class="text-end mt-4"><button class="m-btn m-btn--primaire" type="button" data-modale-fermer>Fermer</button></div>
  </div>
</div>
{% endblock %}
{% endblock %}
