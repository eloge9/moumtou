{% extends 'base.html.twig' %}

{% block title %}Espace enseignant — MOUMTOU{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}

{% block header %}{% include 'components/_header_minimal.html.twig' with {context_label: 'Espace enseignant'} %}{% endblock %}

{% block body %}
<section class="m-section">
  <h1 style="font-size:26px">Bonjour {{ teacher.firstName }}</h1>
  <p class="m-texte mt-2">Retrouvez ici les soutenances auxquelles vous êtes invité(e) en tant que membre du jury.</p>

  <div class="row g-4 mt-2">
    <div class="col-lg-4">
      <div class="m-carte m-carte--plate p-3">
        <p class="m-surtitre mb-2">Mes établissements</p>
        {% for attachment in attachments %}
          <div class="d-flex align-items-center justify-content-between py-2" style="border-bottom:1px solid #EEF1F6">
            <span class="fw-semibold" style="font-size:14.5px">{{ attachment.institution.name }}</span>
            <form method="post" action="{{ path('app_teacher_remove_institution', {id: attachment.id}) }}">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('enseignant-institution-retirer-' ~ attachment.id) }}">
              <button class="m-btn m-btn--lien" type="submit" style="font-size:13px;padding:0">Retirer</button>
            </form>
          </div>
        {% else %}
          <p class="m-meta mb-2">Aucun établissement renseigné pour l'instant.</p>
        {% endfor %}
        <form method="post" action="{{ path('app_teacher_set_institution') }}" class="d-grid gap-2 mt-3">
          <select class="m-select" name="institution">
            <option value="">Ajouter un établissement…</option>
            {% for institution in institutions %}
              <option value="{{ institution.id }}">{{ institution.name }}</option>
            {% endfor %}
          </select>
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('enseignant-institution') }}">
          <button class="m-btn m-btn--secondaire" type="submit">Ajouter</button>
        </form>
        <button class="m-btn m-btn--secondaire m-btn--sm mt-2" type="button" data-modale-ouvrir="modale-demande-etablissement">Mon établissement n'est pas dans la liste</button>
      </div>
    </div>

    <div class="col-lg-8">
      <p class="m-surtitre mb-2">Mes invitations de jury</p>
      <div class="d-grid gap-3">
        {% for invitation in invitations %}
          {% set defense = invitation.defense %}
          {% set project = defense.project %}
          <div class="m-carte m-carte--plate p-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <div>
                <p class="fw-bold mb-1"><a href="{{ path('app_project_show', {slug: project.slug}) }}">{{ project.name }}</a></p>
                <p class="m-meta mb-0">{{ project.owner.fullName }} · {{ invitation.role.label }} · {{ defense.date|date('d F Y') }} à {{ defense.time }} — {{ defense.place }}</p>
              </div>
              <span class="m-tag{{ invitation.status.value == 'confirme' ? ' m-tag--bleu' : '' }}">{{ invitation.status.label }}</span>
            </div>
            {% if invitation.status.value == 'en_attente' %}
              <div class="d-flex gap-2 mt-3">
                <form method="post" action="{{ path('app_teacher_respond_jury', {id: invitation.id}) }}">
                  <input type="hidden" name="decision" value="confirmer">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('repondre-jury-' ~ invitation.id) }}">
                  <button class="m-btn m-btn--primaire m-btn--sm" type="submit">Confirmer ma participation</button>
                </form>
                <form method="post" action="{{ path('app_teacher_respond_jury', {id: invitation.id}) }}">
                  <input type="hidden" name="decision" value="refuser">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('repondre-jury-' ~ invitation.id) }}">
                  <button class="m-btn m-btn--secondaire m-btn--sm" type="submit">Refuser</button>
                </form>
              </div>
            {% endif %}

            {% if invitation.status.value == 'confirme' and defense.status.value != 'annoncee' %}
              <div class="mt-3 pt-3" style="border-top:1px solid #EEF1F6">
                {% if defense.status.value == 'verifiee' %}
                  <p class="m-avis mb-2">✓ Soutenance vérifiée par {{ defense.validationCount }} membre{{ defense.validationCount > 1 ? 's' : '' }} du jury.</p>
                {% elseif invitation.id in validatedInvitationIds %}
                  <p class="m-meta mb-2">✓ Vous avez confirmé la tenue de cette soutenance. En attente d'une 2ᵉ confirmation ({{ defense.validationCount }}/2).</p>
                {% else %}
                  <form method="post" action="{{ path('app_teacher_validate_defense', {id: invitation.id}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('valider-soutenance-' ~ invitation.id) }}">
                    <button class="m-btn m-btn--primaire m-btn--sm" type="submit">Je confirme que cette soutenance a bien eu lieu</button>
                  </form>
                {% endif %}

                {% set result = defense.academicResult %}
                <details class="mt-3">
                  <summary class="m-meta" style="cursor:pointer">Résultat de la soutenance {% if result and result.validated %}(validé){% elseif result %}(en attente de validation){% endif %}</summary>
                  <form method="post" action="{{ path('app_defense_result_submit', {id: defense.id}) }}" class="mt-2 d-grid gap-2" style="max-width:420px">
                    <div class="row g-2">
                      <div class="col-md-6">
                        <label class="m-label">Note / 20</label>
                        <input class="m-input" type="number" step="0.5" min="0" max="20" name="grade" value="{{ result ? result.grade }}" {{ result and result.validated ? 'disabled' }}>
                      </div>
                      <div class="col-md-6">
                        <label class="m-label">Décision</label>
                        <select class="m-select" name="decision" {{ result and result.validated ? 'disabled' }}>
                          {% for d in decisions %}<option value="{{ d.value }}" {{ result and result.decision.value == d.value ? 'selected' }}>{{ d.label }}</option>{% endfor %}
                        </select>
                      </div>
                      <div class="col-12">
                        <label class="m-label">Statut du résultat</label>
                        <select class="m-select" name="status" {{ result and result.validated ? 'disabled' }}>
                          {% for s in resultStatuses %}<option value="{{ s.value }}" {{ result and result.status.value == s.value ? 'selected' }}>{{ s.label }}</option>{% endfor %}
                        </select>
                      </div>
                      <div class="col-12">
                        <label class="m-label">Appréciation du jury</label>
                        <textarea class="m-textarea" name="appreciation" {{ result and result.validated ? 'disabled' }}>{{ result ? result.appreciation }}</textarea>
                      </div>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('resultat-soutenance-' ~ defense.id) }}">
                    {% if not (result and result.validated) %}
                      <button class="m-btn m-btn--secondaire m-btn--sm" type="submit">Enregistrer le résultat</button>
                    {% endif %}
                  </form>
                  {% if invitation.role.value == 'president' and result and not result.validated %}
                    <form method="post" action="{{ path('app_defense_result_validate', {id: defense.id}) }}" class="mt-2">
                      <input type="hidden" name="_csrf_token" value="{{ csrf_token('valider-resultat-' ~ defense.id) }}">
                      <button class="m-btn m-btn--primaire m-btn--sm" type="submit">Valider le résultat final (président du jury)</button>
                    </form>
                  {% endif %}
                </details>
              </div>
            {% endif %}
          </div>
        {% else %}
          <p class="m-meta">Aucune invitation pour l'instant. Si vous avez été cité(e) comme membre du jury avant de créer votre compte, vos invitations apparaîtront ici automatiquement.</p>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% block modals %}
  {% include 'components/_institution_request_modal.html.twig' with {redirect_path: path('app_teacher_dashboard')} %}
{% endblock %}
{% endblock %}
