{% extends 'base.html.twig' %}

{% block title %}Bienvenue — MOUMTOU{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block header %}
  {% include 'components/_header_minimal.html.twig' with {context_label: 'Bienvenue'} %}
{% endblock %}

{% block body %}
<section class="m-section d-flex justify-content-center">
  <div class="col-12 col-md-8 col-lg-5 text-center">
    <div class="m-carte m-carte--plate p-4">
      <h1 style="font-size:26px">Bienvenue sur MOUMTOU 👋</h1>
      <p class="m-texte mt-3">
        Votre compte a été créé avec succès.
      </p>
      <p class="m-texte mb-0">
        Complétez votre profil pour commencer à présenter vos projets et vos compétences.
      </p>
      <a class="m-btn m-btn--primaire m-btn--lg mt-4" href="{{ path(nextRoute) }}">Compléter mon profil</a>
    </div>
  </div>
</section>
{% endblock %}
