{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — MOUMTOU{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}
{% block header %}{% include 'components/_header_minimal.html.twig' with {context_label: 'Mot de passe oublié'} %}{% endblock %}

{% block body %}
<section class="m-section d-flex justify-content-center">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="text-center mb-4">
      <h1 style="font-size:26px">Mot de passe oublié</h1>
      <p class="m-texte mt-2">Indiquez votre adresse e-mail, nous vous enverrons un lien de réinitialisation.</p>
    </div>
    <div class="m-carte m-carte--plate p-4">
      <form method="post">
        <label class="m-label" for="email">Adresse e-mail <span style="color:var(--m-bleu)">obligatoire</span></label>
        <input class="m-input" type="email" id="email" name="email" required autofocus>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('mot-de-passe-oublie') }}">
        <button class="m-btn m-btn--primaire m-btn--bloc m-btn--lg mt-3" type="submit">Envoyer le lien</button>
      </form>
    </div>
    <p class="m-meta text-center mt-3 mb-0"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
  </div>
</section>
{% endblock %}
