{% extends 'base.html.twig' %}

{% block title %}Vérifiez votre e-mail — MOUMTOU{% endblock %}
{% block header %}{% include 'components/_header_minimal.html.twig' with {context_label: 'Mot de passe oublié'} %}{% endblock %}

{% block body %}
<section class="m-section d-flex justify-content-center">
  <div class="col-12 col-md-8 col-lg-5 text-center">
    <div class="m-carte m-carte--plate p-4">
      <h1 style="font-size:22px">Vérifiez votre boîte e-mail</h1>
      <p class="m-texte mt-3 mb-0">Si un compte existe avec cette adresse, un lien de réinitialisation vient de lui être envoyé.</p>
      {% if devSignedUrl %}
        <div class="m-avis mt-4 text-start">
          <strong>Mode développement :</strong> <a href="{{ devSignedUrl }}" style="word-break:break-all">{{ devSignedUrl }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% endblock %}
