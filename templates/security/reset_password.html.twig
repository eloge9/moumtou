{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — MOUMTOU{% endblock %}
{% block header %}{% include 'components/_header_minimal.html.twig' with {context_label: 'Nouveau mot de passe'} %}{% endblock %}

{% block body %}
<section class="m-section d-flex justify-content-center">
  <div class="col-12 col-md-8 col-lg-5">
    <h1 class="text-center mb-4" style="font-size:26px">Choisissez un nouveau mot de passe</h1>
    <div class="m-carte m-carte--plate p-4">
      {% if errors|length %}
        <p class="m-avis mb-3" style="color:#B3261E;background:#FDECEA;border-color:#F5C6C2">
          {% for error in errors %}<span class="d-block">{{ error }}</span>{% endfor %}
        </p>
      {% endif %}
      <form method="post">
        <label class="m-label" for="password">Nouveau mot de passe <span style="color:var(--m-bleu)">obligatoire</span></label>
        <input class="m-input" type="password" id="password" name="password" required>
        <label class="m-label mt-3" for="confirm">Confirmer le mot de passe <span style="color:var(--m-bleu)">obligatoire</span></label>
        <input class="m-input" type="password" id="confirm" name="confirm" required>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('reinitialiser-mot-de-passe') }}">
        <button class="m-btn m-btn--primaire m-btn--bloc m-btn--lg mt-4" type="submit">Réinitialiser</button>
      </form>
    </div>
  </div>
</section>
{% endblock %}
