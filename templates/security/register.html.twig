{% extends 'base.html.twig' %}
{% import 'components/_form_macros.html.twig' as forms %}

{% block title %}Créer un compte — MOUMTOU{% endblock %}

{% block header %}
  {% include 'components/_header_minimal.html.twig' with {context_label: 'Créer un compte'} %}
{% endblock %}

{% block body %}
<section class="m-section d-flex justify-content-center">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="text-center mb-4">
      <h1 style="font-size:26px">Créez votre compte</h1>
      <p class="m-texte mt-2">L'inscription est gratuite. Vous pourrez publier un projet dès que votre e-mail sera confirmé.</p>
    </div>

    <div class="m-carte m-carte--plate p-4">
      {{ form_start(registrationForm, {attr: {novalidate: 'novalidate'}}) }}

        {% if not registrationForm.vars.valid %}
          <p class="m-avis mb-3" style="color:#B3261E;background:#FDECEA;border-color:#F5C6C2">
            Merci de corriger les champs signalés ci-dessous.
          </p>
        {% endif %}

        <div class="mb-3">
          {{ forms.label(registrationForm.firstName, 'Prénom', true) }}
          {{ form_widget(registrationForm.firstName, {attr: {class: 'm-input'}}) }}
          {{ form_errors(registrationForm.firstName) }}
        </div>

        <div class="mb-3">
          {{ forms.label(registrationForm.lastName, 'Nom', true) }}
          {{ form_widget(registrationForm.lastName, {attr: {class: 'm-input'}}) }}
          {{ form_errors(registrationForm.lastName) }}
        </div>

        <div class="mb-3">
          {{ forms.label(registrationForm.phone, 'Téléphone', true) }}
          {{ form_widget(registrationForm.phone, {attr: {class: 'm-input'}}) }}
          {{ form_errors(registrationForm.phone) }}
        </div>

        <div class="mb-3">
          {{ forms.label(registrationForm.email, 'Adresse e-mail', true) }}
          {{ form_widget(registrationForm.email, {attr: {class: 'm-input'}}) }}
          {{ form_errors(registrationForm.email) }}
        </div>

        <div class="mb-3">
          {{ forms.label(registrationForm.plainPassword.first, 'Mot de passe', true) }}
          {{ form_widget(registrationForm.plainPassword.first, {attr: {class: 'm-input'}}) }}
          {{ form_errors(registrationForm.plainPassword.first) }}
        </div>

        <div class="mb-4">
          {{ forms.label(registrationForm.plainPassword.second, 'Confirmer le mot de passe', true) }}
          {{ form_widget(registrationForm.plainPassword.second, {attr: {class: 'm-input'}}) }}
          {{ form_errors(registrationForm.plainPassword.second) }}
        </div>

        <button class="m-btn m-btn--primaire m-btn--bloc m-btn--lg" type="submit">Créer mon compte</button>
      {{ form_end(registrationForm) }}
    </div>

    <p class="m-meta text-center mt-3 mb-0">
      Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a>
    </p>
  </div>
</section>
{% endblock %}
