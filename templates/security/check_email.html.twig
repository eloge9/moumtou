{% extends 'base.html.twig' %}

{% block title %}Vérifiez votre e-mail — MOUMTOU{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}

{% block header %}
  {% include 'components/_header_minimal.html.twig' with {context_label: 'Créer un compte'} %}
{% endblock %}

{% block body %}
<section class="m-section d-flex justify-content-center">
  <div class="col-12 col-md-8 col-lg-5 text-center">
    <div class="m-carte m-carte--plate p-4">
      <p class="m-surtitre m-surtitre--bleu mb-2">Dernière étape</p>
      <h1 style="font-size:24px">Vérifiez votre boîte e-mail</h1>
      <p class="m-texte mt-3 mb-0">
        Un e-mail de confirmation a été envoyé à <strong>{{ email }}</strong>. Cliquez sur le lien qu'il contient pour activer votre compte.
      </p>

      {% if devSignedUrl %}
        <div class="m-avis mt-4 text-start">
          <strong>Mode développement :</strong> aucun serveur d'envoi d'e-mail n'est configuré (MAILER_DSN=null://null). Utilisez ce lien pour confirmer manuellement :<br>
          <a href="{{ devSignedUrl }}" style="word-break:break-all">{{ devSignedUrl }}</a>
        </div>
      {% endif %}
    </div>

    <p class="m-meta mt-3 mb-0">
      Vous n'avez rien reçu ? Vérifiez vos courriers indésirables ou <a href="{{ path('app_register') }}">recommencez l'inscription</a>.
    </p>
  </div>
</section>
{% endblock %}
