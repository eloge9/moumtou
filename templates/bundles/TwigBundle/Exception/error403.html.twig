{% extends 'base.html.twig' %}

{% block title %}Accès refusé — MOUMTOU{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block header %}{% include 'components/_header_minimal.html.twig' with {context_label: 'Accès refusé'} %}{% endblock %}

{% block body %}
<section class="m-section d-flex justify-content-center">
  <div class="col-12 col-md-8 col-lg-5 text-center">
    <p class="m-surtitre m-surtitre--bleu mb-2">Erreur 403</p>
    <h1 style="font-size:28px">Accès refusé</h1>
    <p class="m-texte mt-3">
      Cette page est réservée à un autre profil (talent, enseignant, recruteur ou administrateur).
      {% if app.user %}
        Votre compte actuel n'a pas les droits nécessaires pour la consulter.
      {% else %}
        Connectez-vous avec un compte disposant des droits nécessaires pour la consulter.
      {% endif %}
    </p>
    <div class="d-flex justify-content-center gap-2 mt-4">
      <a class="m-btn m-btn--primaire" href="{{ path('app_home') }}">Retour à l'accueil</a>
      {% if not app.user %}<a class="m-btn m-btn--secondaire" href="{{ path('app_login') }}">Se connecter</a>{% endif %}
    </div>
  </div>
</section>
{% endblock %}
