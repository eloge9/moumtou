{% extends 'base.html.twig' %}

{% block title %}Page introuvable — MOUMTOU{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block header %}{% include 'components/_header_minimal.html.twig' with {context_label: 'Page introuvable'} %}{% endblock %}

{% block body %}
<section class="m-section d-flex justify-content-center">
  <div class="col-12 col-md-8 col-lg-5 text-center">
    <p class="m-surtitre m-surtitre--bleu mb-2">Erreur 404</p>
    <h1 style="font-size:28px">Page introuvable</h1>
    <p class="m-texte mt-3">Le contenu recherché n'existe pas, a été retiré, ou n'est pas (ou plus) publié.</p>
    <div class="d-flex justify-content-center gap-2 mt-4">
      <a class="m-btn m-btn--primaire" href="{{ path('app_home') }}">Retour à l'accueil</a>
      <a class="m-btn m-btn--secondaire" href="{{ path('app_explorer') }}">Explorer les projets</a>
    </div>
  </div>
</section>
{% endblock %}
