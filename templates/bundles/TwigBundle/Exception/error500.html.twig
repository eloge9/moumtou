{% extends 'base.html.twig' %}

{% block title %}Une erreur est survenue — MOUMTOU{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block header %}{% include 'components/_header_minimal.html.twig' with {context_label: 'Erreur'} %}{% endblock %}

{% block body %}
<section class="m-section d-flex justify-content-center">
  <div class="col-12 col-md-8 col-lg-5 text-center">
    <p class="m-surtitre mb-2" style="color:#B3261E">Erreur 500</p>
    <h1 style="font-size:28px">Une erreur est survenue</h1>
    <p class="m-texte mt-3">
      Un problème technique est survenu de notre côté. Ce n'est pas votre faute — notre équipe en a déjà été informée.
    </p>
    {% if requestId %}
      <p class="m-meta mt-2">Référence : <strong>{{ requestId }}</strong></p>
      <p class="m-meta">Si le problème persiste, communiquez cette référence à l'équipe MOUMTOU.</p>
    {% endif %}
    <div class="d-flex justify-content-center gap-2 mt-4">
      <a class="m-btn m-btn--primaire" href="{{ path('app_home') }}">Retour à l'accueil</a>
      <button class="m-btn m-btn--secondaire" type="button" onclick="location.reload()">Réessayer</button>
    </div>
  </div>
</section>
{% endblock %}
