{% extends 'base.html.twig' %}

{% block title %}{{ title }} — MOUMTOU{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block header %}{% include 'components/_header_minimal.html.twig' with {context_label: title} %}{% endblock %}

{% block body %}
<section class="m-section d-flex justify-content-center">
  <div class="col-12 col-md-8 col-lg-5 text-center">
    <p class="m-surtitre mb-2" style="color:#B36B00">Erreur {{ statusCode }}</p>
    <h1 style="font-size:28px">{{ title }}</h1>
    <p class="m-texte mt-3">{{ message }}</p>
    {% if requestId %}<p class="m-meta mt-2">Référence : <strong>{{ requestId }}</strong></p>{% endif %}
    <div class="d-flex justify-content-center gap-2 mt-4">
      <a class="m-btn m-btn--primaire" href="{{ path('app_home') }}">Retour à l'accueil</a>
    </div>
  </div>
</section>
{% endblock %}
