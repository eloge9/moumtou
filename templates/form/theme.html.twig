{# Thème de formulaire minimal : n'affecte que le rendu des erreurs de champ,
   pour rester cohérent avec la charte MOUMTOU (m-*) sans surcharger les widgets. #}
{% block form_errors %}
{% if errors|length > 0 %}
<div class="mt-1">
  {% for error in errors %}
    <p class="m-0" style="font-size:12.5px;color:#B3261E;font-weight:600">{{ error.message }}</p>
  {% endfor %}
</div>
{% endif %}
{% endblock form_errors %}
