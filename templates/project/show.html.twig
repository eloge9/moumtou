{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} — MOUMTOU{% endblock %}
{% block meta_description %}{{ (project.shortDescription ?: project.detailedDescription ?: 'Découvrez ' ~ project.name ~ ' par ' ~ project.owner.fullName ~ ' sur MOUMTOU.')|striptags|slice(0, 160) }}{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ publicUrl }}">{% endblock %}
{% block og_type %}article{% endblock %}
{% block og_title %}{{ project.name }} — MOUMTOU{% endblock %}
{% block og_description %}{{ block('meta_description') }}{% endblock %}
{% block og_image %}{% if project.photos|length %}<meta property="og:image" content="{{ absolute_url(asset(project.photos.first.path)) }}">{% endif %}{% endblock %}
{% block structured_data %}
<script type="application/ld+json">
{{ {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  'name': project.name,
  'description': (project.shortDescription ?: project.detailedDescription),
  'url': publicUrl,
  'dateCreated': project.realizationDate ? project.realizationDate|date('Y-m-d') : null,
  'creator': {'@type': 'Person', 'name': project.owner.fullName},
  'keywords': project.technologies|map(t => t.name)|join(', '),
  'aggregateRating': project.ratingsCount > 0 ? {
    '@type': 'AggregateRating',
    'ratingValue': project.ratingAverage,
    'ratingCount': project.ratingsCount,
  } : null,
}|filter(v => v is not null)|json_encode|raw }}
</script>
{% endblock %}

{% block header %}
<header class="m-header">
  <a class="m-brand" href="{{ path('app_home') }}"><span class="m-brand__mark">M</span>MOUMTOU</a>
  <nav class="m-nav" data-nav>
    <a class="m-nav__link is-active" href="{{ path('app_explorer') }}">Explorer</a>
  </nav>
  <div class="ms-auto d-flex align-items-center gap-2">
    {% if is_granted('PROJECT_EDIT', project) %}
      <a class="m-btn m-btn--secondaire" href="{{ path('app_project_edit', {slug: project.slug}) }}">Modifier</a>
      <form method="post" action="{{ path('app_project_delete', {slug: project.slug}) }}" onsubmit="return confirm('Supprimer définitivement ce projet ?');">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('supprimer-projet-' ~ project.id) }}">
        <button class="m-btn m-btn--secondaire" type="submit" style="color:#B3261E">Supprimer</button>
      </form>
    {% endif %}
    <button class="m-btn m-btn--secondaire" type="button" data-modale-ouvrir="modale-partage">Partager</button>
    {% if app.user %}
      <button class="m-btn m-btn--secondaire" type="button" data-modale-ouvrir="modale-signalement">Signaler</button>
    {% endif %}
    <span class="m-avatar"></span>
  </div>
</header>
{% endblock %}

{% block body %}

<p class="m-fil m-0 px-4 py-3" style="background:var(--m-fond);border-bottom:1px solid var(--m-bordure)">
  <a href="{{ path('app_explorer') }}">Explorer</a>
  {% if project.domain %} / {{ project.domain.name }} / {{ project.mention.name }} / <strong>{{ project.specialty.name }}</strong>
  {% else %} / <strong>{{ project.type.shortLabel }}</strong>{% endif %}
</p>

<div class="m-detail">
  <main class="m-detail__principal">
    <div class="d-flex flex-wrap gap-2">
      <span class="m-badge m-badge--type">{{ project.type.label }}</span>
      {% if project.status.value == 'verifie' %}
        <span class="m-badge m-badge--verifie">✅ {{ project.type.value == 'soutenance' ? 'Soutenance vérifiée par le jury' : 'Projet vérifié' }}</span>
      {% elseif project.status.value == 'publie' %}
        <span class="m-badge">🌐 Projet publié</span>
        <span class="m-badge" style="color:#B36B00;background:#FFF4E5">⚠️ Pas encore vérifié</span>
      {% endif %}
    </div>

    <h1 class="mt-3" style="font-size:38px;line-height:1.1;letter-spacing:-.032em;max-width:640px">{{ project.name }}</h1>
    {% if project.shortDescription %}<p class="m-texte mt-3" style="font-size:17px;max-width:640px">{{ project.shortDescription }}</p>{% endif %}

    <div class="d-flex align-items-center gap-3 mt-4 py-3" style="border-top:1px solid #EEF1F6;border-bottom:1px solid #EEF1F6">
      <span class="m-avatar" style="width:44px;height:44px"></span>
      <div>
        <p class="fw-bold mb-0" style="font-size:15.5px">{{ project.owner.fullName }}</p>
        <p class="m-meta mb-0">{{ project.institution ? project.institution.name : project.type.label }}</p>
      </div>
      <div class="ms-auto text-end">
        <p class="fw-bold mb-0" style="font-size:19px">★ {{ project.ratingAverage|number_format(1, ',') }} <span class="m-meta fw-semibold">/ 5</span></p>
        <p class="m-meta mb-0">{{ project.ratingsCount }} évaluation{{ project.ratingsCount > 1 ? 's' : '' }}</p>
      </div>
    </div>

    {% set photos = project.photos %}
    <div class="m-media m-media--h320 mt-4">
      {% if photos|length %}<img src="{{ asset(photos.first.path) }}" alt="" style="width:100%;height:100%;object-fit:cover">
      {% else %}<span class="m-media__etiquette">capture principale du projet</span>{% endif %}
    </div>
    {% if photos|length > 1 %}
      <div class="row g-2 mt-2">
        {% for photo in photos|slice(1, 3) %}
          <div class="col-3"><div class="m-media m-media--vignette"><img src="{{ asset(photo.thumbnailPath ?: photo.path) }}" alt="" style="width:100%;height:100%;object-fit:cover" loading="lazy"></div></div>
        {% endfor %}
        {% if photos|length > 4 %}
          <div class="col-3"><div class="m-media m-media--vignette justify-content-center fw-bold" style="color:var(--m-bleu)">+{{ photos|length - 4 }}</div></div>
        {% endif %}
      </div>
    {% endif %}

    {% if project.detailedDescription %}
      <h2 class="mt-5" style="font-size:20px">Description</h2>
      <p class="m-texte mt-2" style="font-size:15.5px;line-height:1.65;max-width:680px">{{ project.detailedDescription|nl2br }}</p>
    {% endif %}

    {% if project.technologies|length %}
      <h2 class="mt-4" style="font-size:20px">Technologies</h2>
      <div class="m-tags mt-2">
        {% for tech in project.technologies %}<span class="m-tag">{{ tech.name }}</span>{% endfor %}
      </div>
    {% endif %}

    {% if project.proofs|length %}
      <h2 class="mt-4" style="font-size:20px">Preuves de réalisation</h2>
      <div class="row g-3 mt-2">
        {% for proof in project.proofs %}
          <div class="col-md-6">
            <a class="m-preuve" href="{{ proof.url }}" target="_blank" rel="noopener">
              <span class="m-preuve__icone">{{ proof.type.value == 'github' ? '</>' : '≡' }}</span>
              <span><span class="fw-bold d-block" style="font-size:14.5px">{{ proof.type.label }}</span><span class="m-meta">{{ proof.url }}</span></span>
            </a>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if youtubeEmbedUrl %}
      <div class="mt-3" style="position:relative;padding-top:56.25%;border-radius:var(--m-r);overflow:hidden">
        <iframe src="{{ youtubeEmbedUrl }}" title="Vidéo de démonstration" frameborder="0" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%"></iframe>
      </div>
    {% endif %}

    <section class="mt-5 pt-4" style="border-top:1px solid var(--m-bordure)">
      <div class="d-flex align-items-center justify-content-between">
        <h2 style="font-size:20px">Commentaires <span style="color:#A2ABBD">{{ comments|length }}</span></h2>
        {% if app.user %}
          <button class="m-btn m-btn--primaire" type="button" data-modale-ouvrir="modale-commentaire">Écrire un commentaire</button>
        {% else %}
          <a class="m-btn m-btn--secondaire" href="{{ path('app_login') }}">Se connecter pour commenter</a>
        {% endif %}
      </div>

      {% for comment in comments %}
        <article class="m-commentaire mt-3">
          <div class="d-flex align-items-center gap-2">
            <span class="m-avatar" style="width:32px;height:32px{% if comment.author.photo %};background-image:url('{{ asset(comment.author.photo) }}');background-size:cover;background-position:center{% endif %}"></span>
            <div><p class="fw-bold mb-0" style="font-size:14.5px">{{ comment.author.fullName }}</p><p class="m-meta mb-0">{{ comment.createdAt|date('d/m/Y à H:i') }}{% if comment.isEdited %} · <span class="m-meta">Modifié</span>{% endif %}</p></div>
          </div>
          <p class="m-texte mt-3 mb-0">{{ comment.content }}</p>
          <div class="m-commentaire__actions">
            {% if app.user %}
              <button type="button" data-modale-ouvrir="modale-reponse-{{ comment.id }}">Répondre</button>
            {% endif %}
            {% if is_granted('COMMENT_EDIT', comment) %}
              <button type="button" data-modale-ouvrir="modale-modifier-{{ comment.id }}">Modifier</button>
            {% endif %}
            {% if is_granted('COMMENT_DELETE', comment) %}
              <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}" onsubmit="return confirm('Supprimer ce commentaire ?');">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('supprimer-commentaire-' ~ comment.id) }}">
                <button type="submit">Supprimer</button>
              </form>
            {% endif %}
            {% if app.user and comment.author != app.user %}
              <button type="button" data-modale-ouvrir="modale-signaler-commentaire-{{ comment.id }}">🚩 Signaler</button>
            {% endif %}
          </div>
          {% if app.user %}
          <div class="m-modale" id="modale-reponse-{{ comment.id }}" data-modale role="dialog" aria-modal="true">
            <div class="m-modale__boite">
              <form method="post" action="{{ path('app_comment_reply', {id: comment.id}) }}">
                <h2 class="m-modale__titre">Répondre à {{ comment.author.fullName }}</h2>
                <textarea class="m-textarea mt-3" name="content" placeholder="Votre réponse" maxlength="2000" required></textarea>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('repondre-commentaire-' ~ comment.id) }}">
                <div class="d-flex justify-content-end gap-2 mt-3">
                  <button class="m-btn m-btn--secondaire" type="button" data-modale-fermer>Annuler</button>
                  <button class="m-btn m-btn--primaire" type="submit">Répondre</button>
                </div>
              </form>
            </div>
          </div>
          <div class="m-modale" id="modale-signaler-commentaire-{{ comment.id }}" data-modale role="dialog" aria-modal="true">
            <div class="m-modale__boite">
              <form method="post" action="{{ path('app_comment_report', {id: comment.id}) }}">
                <h2 class="m-modale__titre">Signaler ce commentaire</h2>
                <label class="m-label mt-3" for="motif-commentaire-{{ comment.id }}">Motif</label>
                <select class="m-select" id="motif-commentaire-{{ comment.id }}" name="reason">
                  {% for reason in reportReasons %}<option value="{{ reason.value }}">{{ reason.label }}</option>{% endfor %}
                </select>
                <label class="m-label mt-3" for="details-commentaire-{{ comment.id }}">Précisions</label>
                <textarea class="m-textarea" id="details-commentaire-{{ comment.id }}" name="details" placeholder="Décrivez le problème constaté."></textarea>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('signalement-commentaire-' ~ comment.id) }}">
                <div class="d-flex justify-content-end gap-2 mt-4">
                  <button class="m-btn m-btn--secondaire" type="button" data-modale-fermer>Annuler</button>
                  <button class="m-btn m-btn--primaire" type="submit">Envoyer le signalement</button>
                </div>
              </form>
            </div>
          </div>
          {% endif %}
          {% if is_granted('COMMENT_EDIT', comment) %}
          <div class="m-modale" id="modale-modifier-{{ comment.id }}" data-modale role="dialog" aria-modal="true">
            <div class="m-modale__boite">
              <form method="post" action="{{ path('app_comment_edit', {id: comment.id}) }}">
                <h2 class="m-modale__titre">Modifier mon commentaire</h2>
                <textarea class="m-textarea mt-3" name="content" maxlength="2000" required>{{ comment.content }}</textarea>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('modifier-commentaire-' ~ comment.id) }}">
                <div class="d-flex justify-content-end gap-2 mt-3">
                  <button class="m-btn m-btn--secondaire" type="button" data-modale-fermer>Annuler</button>
                  <button class="m-btn m-btn--primaire" type="submit">Enregistrer</button>
                </div>
              </form>
            </div>
          </div>
          {% endif %}
          {% for reply in comment.replies %}
            {% if reply.status.value == 'visible' %}
              <div class="m-commentaire__reponse">
                <div class="d-flex align-items-center gap-2">
                  <span class="m-avatar" style="width:28px;height:28px{% if reply.author.photo %};background-image:url('{{ asset(reply.author.photo) }}');background-size:cover;background-position:center{% endif %}"></span>
                  <p class="fw-bold mb-0" style="font-size:14px">{{ reply.author.fullName }}{% if reply.author == project.owner %} <span class="m-tag m-tag--bleu">Auteur</span>{% endif %}</p>
                  <p class="m-meta mb-0">{{ reply.createdAt|date('d/m/Y à H:i') }}{% if reply.isEdited %} · Modifié{% endif %}</p>
                </div>
                <p class="m-texte mt-2 mb-0">{{ reply.content }}</p>
                <div class="m-commentaire__actions">
                  {% if is_granted('COMMENT_EDIT', reply) %}
                    <button type="button" data-modale-ouvrir="modale-modifier-{{ reply.id }}">Modifier</button>
                  {% endif %}
                  {% if is_granted('COMMENT_DELETE', reply) %}
                    <form method="post" action="{{ path('app_comment_delete', {id: reply.id}) }}" onsubmit="return confirm('Supprimer cette réponse ?');">
                      <input type="hidden" name="_csrf_token" value="{{ csrf_token('supprimer-commentaire-' ~ reply.id) }}">
                      <button type="submit">Supprimer</button>
                    </form>
                  {% endif %}
                  {% if app.user and reply.author != app.user %}
                    <button type="button" data-modale-ouvrir="modale-signaler-commentaire-{{ reply.id }}">🚩 Signaler</button>
                  {% endif %}
                </div>
                {% if app.user %}
                <div class="m-modale" id="modale-signaler-commentaire-{{ reply.id }}" data-modale role="dialog" aria-modal="true">
                  <div class="m-modale__boite">
                    <form method="post" action="{{ path('app_comment_report', {id: reply.id}) }}">
                      <h2 class="m-modale__titre">Signaler cette réponse</h2>
                      <label class="m-label mt-3" for="motif-commentaire-{{ reply.id }}">Motif</label>
                      <select class="m-select" id="motif-commentaire-{{ reply.id }}" name="reason">
                        {% for reason in reportReasons %}<option value="{{ reason.value }}">{{ reason.label }}</option>{% endfor %}
                      </select>
                      <input type="hidden" name="_csrf_token" value="{{ csrf_token('signalement-commentaire-' ~ reply.id) }}">
                      <div class="d-flex justify-content-end gap-2 mt-4">
                        <button class="m-btn m-btn--secondaire" type="button" data-modale-fermer>Annuler</button>
                        <button class="m-btn m-btn--primaire" type="submit">Envoyer le signalement</button>
                      </div>
                    </form>
                  </div>
                </div>
                {% endif %}
                {% if is_granted('COMMENT_EDIT', reply) %}
                <div class="m-modale" id="modale-modifier-{{ reply.id }}" data-modale role="dialog" aria-modal="true">
                  <div class="m-modale__boite">
                    <form method="post" action="{{ path('app_comment_edit', {id: reply.id}) }}">
                      <h2 class="m-modale__titre">Modifier ma réponse</h2>
                      <textarea class="m-textarea mt-3" name="content" maxlength="2000" required>{{ reply.content }}</textarea>
                      <input type="hidden" name="_csrf_token" value="{{ csrf_token('modifier-commentaire-' ~ reply.id) }}">
                      <div class="d-flex justify-content-end gap-2 mt-3">
                        <button class="m-btn m-btn--secondaire" type="button" data-modale-fermer>Annuler</button>
                        <button class="m-btn m-btn--primaire" type="submit">Enregistrer</button>
                      </div>
                    </form>
                  </div>
                </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </article>
      {% else %}
        <p class="m-meta mt-3">Aucun commentaire pour le moment.</p>
        <p class="m-meta mb-0">Soyez le premier à donner votre avis.</p>
      {% endfor %}
    </section>
  </main>

  <aside class="m-detail__cote">
    {% if project.defense %}
      {% set defense = project.defense %}
      <div class="m-carte m-carte--plate p-3">
        <p class="m-surtitre mb-2">Soutenance</p>
        <p class="fw-bold mb-1" style="font-size:16px">{{ defense.date|date('d F Y') }} — {{ defense.time }}</p>
        <p class="m-texte mb-3">{{ defense.place }}{% if project.institution %} — {{ project.institution.name }}{% endif %}</p>
        <div class="d-grid gap-2 pt-3" style="border-top:1px solid #EEF1F6;font-size:13.5px">
          {% if project.domain %}<div class="d-flex justify-content-between"><span class="m-meta">Domaine</span><span class="fw-semibold">{{ project.domain.name }}</span></div>{% endif %}
          {% if project.mention %}<div class="d-flex justify-content-between"><span class="m-meta">Mention</span><span class="fw-semibold">{{ project.mention.name }}</span></div>{% endif %}
          {% if project.specialty %}<div class="d-flex justify-content-between"><span class="m-meta">Spécialité</span><span class="fw-semibold">{{ project.specialty.name }}</span></div>{% endif %}
        </div>
        <a class="m-btn m-btn--secondaire m-btn--bloc mt-3" href="{{ path('app_defense_show', {slug: project.slug}) }}">Voir la page de la soutenance</a>
      </div>

      <div class="m-carte m-carte--plate p-3" style="border-color:var(--m-bleu-bordure)">
        {% if defense.status.value == 'verifiee' %}
          <p class="m-statut mb-3">✅ Vérifiée par {{ defense.validationCount }} membre{{ defense.validationCount > 1 ? 's' : '' }} du jury</p>
        {% elseif defense.status.value == 'realisee' %}
          <p class="m-statut mb-3">⚠️ Soutenance réalisée, en attente de vérification ({{ defense.validationCount }}/2)</p>
        {% elseif defense.status.value == 'reportee' %}
          <p class="m-statut mb-3" style="color:#B36B00">🔁 Soutenance reportée</p>
        {% elseif defense.status.value == 'annulee' %}
          <p class="m-statut mb-3" style="color:#B3261E">❌ Soutenance annulée</p>
        {% else %}
          <p class="m-statut mb-3">📅 Soutenance à venir</p>
        {% endif %}
        <div class="d-grid gap-3">
          {% for membre in defense.juryMembers %}
            <div class="d-flex align-items-center gap-2 {{ membre.status.value != 'confirme' ? 'opacity-75' : '' }}">
              <span class="m-avatar" style="width:30px;height:30px"></span>
              <span class="flex-fill"><span class="fw-bold d-block" style="font-size:14px">{{ membre.firstName }} {{ membre.lastName }}</span><span class="m-meta">{{ membre.role.label }}</span></span>
              <span class="m-meta fw-bold" style="{{ membre.status.value == 'confirme' ? 'color:var(--m-bleu)' : '' }}">{{ membre.status.label }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="m-carte m-carte--plate p-3">
      <p class="m-surtitre mb-2">Évaluer ce projet</p>
      {% if not app.user %}
        <p class="m-meta mb-0"><a href="{{ path('app_login') }}">Connectez-vous</a> pour évaluer ce projet.</p>
      {% elseif project.owner == app.user %}
        <p class="m-meta mb-0">Vous ne pouvez pas évaluer votre propre projet.</p>
      {% else %}
        <form method="post" action="{{ path('app_project_rate', {slug: project.slug}) }}" data-note-form>
          <div class="m-note" data-note data-note-initiale="{{ myRating|default(0) }}">
            {% for i in 1..5 %}
              <label>
                <input type="radio" name="value" value="{{ i }}" class="visually-hidden" {{ myRating == i ? 'checked' : '' }}>
                <button class="m-note__etoile" type="button" data-note-etoile aria-label="{{ i }} étoile{{ i > 1 ? 's' : '' }}">★</button>
              </label>
            {% endfor %}
          </div>
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('note') }}">
          <p class="m-meta mt-2 mb-0" data-note-valeur>{{ myRating ? 'Votre évaluation : ' ~ myRating ~ ' / 5' : 'Une évaluation par compte, modifiable.' }}</p>
        </form>
        {% if myRating %}
          <form method="post" action="{{ path('app_project_unrate', {slug: project.slug}) }}" class="mt-2" onsubmit="return confirm('Supprimer votre évaluation ?');">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('annuler-note') }}">
            <button class="m-btn m-btn--secondaire m-btn--sm" type="submit">Supprimer mon évaluation</button>
          </form>
        {% endif %}
      {% endif %}
    </div>

    <div class="m-carte m-carte--plate p-3">
      <p class="m-surtitre mb-2">Contacter le talent</p>
      {% if project.owner.whatsappEnabled and project.owner.whatsapp %}
        <a class="m-btn m-btn--primaire m-btn--bloc" href="https://wa.me/{{ project.owner.whatsapp }}" target="_blank" rel="noopener">Écrire sur WhatsApp</a>
      {% else %}
        <p class="m-meta mb-0">Ce talent n'a pas activé le contact WhatsApp.</p>
      {% endif %}
    </div>

    <div class="m-carte m-carte--plate p-3 text-center">
      <p class="m-surtitre mb-0">QR code du projet</p>
      <img src="{{ qrCodeDataUri }}" alt="QR code vers ce projet" width="100" height="100" class="mt-2">
      <p class="m-meta mt-2 mb-1">À imprimer sur un CV, un poster ou un badge de soutenance.</p>
      <a href="{{ qrCodeDataUri }}" download="moumtou-{{ project.slug }}.svg">Télécharger le QR code</a>
    </div>
  </aside>
</div>

{% block modals %}
<div class="m-modale" id="modale-partage" data-modale role="dialog" aria-modal="true">
  <div class="m-modale__boite">
    <h2 class="m-modale__titre">Partager ce projet</h2>
    <label class="m-label mt-3" for="lien-partage">Lien public</label>
    <input class="m-input" id="lien-partage" type="text" value="{{ publicUrl }}" readonly>
    <div class="d-flex flex-wrap gap-2 mt-3">
      <a class="m-btn m-btn--secondaire" href="https://wa.me/?text={{ publicUrl|url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
      <a class="m-btn m-btn--secondaire" href="https://www.linkedin.com/sharing/share-offsite/?url={{ publicUrl|url_encode }}" target="_blank" rel="noopener">LinkedIn</a>
      <button class="m-btn m-btn--secondaire" type="button" onclick="navigator.clipboard.writeText('{{ publicUrl }}')">Copier le lien</button>
    </div>
    <div class="text-end mt-4"><button class="m-btn m-btn--primaire" type="button" data-modale-fermer>Fermer</button></div>
  </div>
</div>

{% if app.user %}
<div class="m-modale" id="modale-signalement" data-modale role="dialog" aria-modal="true">
  <div class="m-modale__boite">
    <form method="post" action="{{ path('app_project_report', {slug: project.slug}) }}">
      <h2 class="m-modale__titre">Signaler ce contenu</h2>
      <label class="m-label mt-3" for="motif">Motif</label>
      <select class="m-select" id="motif" name="reason">
        {% for reason in reportReasons %}<option value="{{ reason.value }}">{{ reason.label }}</option>{% endfor %}
      </select>
      <label class="m-label mt-3" for="details">Précisions</label>
      <textarea class="m-textarea" id="details" name="details" placeholder="Décrivez le problème constaté."></textarea>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('signalement') }}">
      <div class="d-flex justify-content-end gap-2 mt-4">
        <button class="m-btn m-btn--secondaire" type="button" data-modale-fermer>Annuler</button>
        <button class="m-btn m-btn--primaire" type="submit">Envoyer le signalement</button>
      </div>
    </form>
  </div>
</div>

<div class="m-modale" id="modale-commentaire" data-modale role="dialog" aria-modal="true">
  <div class="m-modale__boite">
    <form method="post" action="{{ path('app_project_comment', {slug: project.slug}) }}">
      <h2 class="m-modale__titre">Écrire un commentaire</h2>
      <textarea class="m-textarea mt-3" name="content" placeholder="Votre question ou votre retour sur ce projet." maxlength="2000" required></textarea>
      <p class="m-meta mt-2">Les commentaires sont modérés. Les propos offensants entraînent une suspension.</p>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('commentaire') }}">
      <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="m-btn m-btn--secondaire" type="button" data-modale-fermer>Annuler</button>
        <button class="m-btn m-btn--primaire" type="submit">Publier</button>
      </div>
    </form>
  </div>
</div>
{% endif %}
{% endblock %}

{% endblock %}
