# Copiez ce fichier vers .env.local et renseignez vos propres valeurs.
# .env.local n'est jamais versionné (voir .gitignore) : c'est là que vont
# les vrais secrets d'environnement, jamais dans .env ni dans le code.

APP_ENV=dev
APP_SECRET=changez-moi-avec-une-chaine-aleatoire

# Format : mysql://utilisateur:mot_de_passe@hôte:3306/moumtou?serverVersion=8.0.32&charset=utf8mb4
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/moumtou?serverVersion=8.0.32&charset=utf8mb4"

# En développement, null://null n'envoie aucun e-mail réel (les liens
# signés apparaissent dans un flash message / dans les logs). En
# production, utilisez un DSN réel, ex. smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null

# Connexion via réseaux sociaux (cahier des charges §5.1). Laissez vide
# pour désactiver un fournisseur : le bouton correspondant affichera un
# message explicite au lieu de planter. URI de redirection à déclarer chez
# chaque fournisseur : https://votre-domaine/connexion/{provider}/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
